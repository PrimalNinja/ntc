                        	 10336: ; ============================================================
                        	 10337: ; String functions. Numbers are passed as the address of a word.
                        	 10338: ; Results go to a string buffer. Dest may be the same as the source.
                        	 10339: ; Most run on the real stack (NTC_RS ... jsr ... NTC_TS).
                        	 10340: ; ============================================================
                        	 10341: 
                        	 10342: ;## ntc_getn
                        	 10343: ; z_p5 = address of a word: A = its value limited to 0 .. 255. Uses Y
                        	 10344: ntc_getn:
00:A388 A001            	 10345: 			ldy #1
00:A38A B110            	 10346: 			lda (z_p5),y
00:A38C 3009            	 10347: 			bmi ntc_gn_zero
00:A38E D004            	 10348: 			bne ntc_gn_max
00:A390 88              	 10349: 			dey
00:A391 B110            	 10350: 			lda (z_p5),y
00:A393 60              	 10351: 			rts
                        	 10352: ntc_gn_max:
00:A394 A9FF            	 10353: 			lda #255
00:A396 60              	 10354: 			rts
                        	 10355: ntc_gn_zero:
00:A397 A900            	 10356: 			lda #0
00:A399 60              	 10357: 			rts
