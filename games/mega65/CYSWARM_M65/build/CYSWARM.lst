                        	   170: NTC_TERM	equ 0		; Option Terminal: 0 none, 1 VT52, 2 ANSI, 3 ADM-3A, 4 Televideo (CP/M)
                        	   171: NTC_TERM_RT	equ 0		; 1: the program calls StdIO.SetTerminal (the terminal is chosen while it runs)
                        	   172: NTC_STRMAX	equ 40		; the longest string (library buffers, temps)
                        	   173: NTC_MEMBANKS	equ 64		; Option Memory: the most 64K banks the Memory class looks for
                        	   174: NTC_ROMENABLE	equ 0		; Option RomEnable (cpcfw, cpcmin): the start code starts the ROMs
                        	   175: NTC_ROMLIB	equ 0		; 1 = the library is the keyword ROM (Library: ROM; ntcRomAsm builds it)
                        	   176: NTC_WINHOLE	equ 0		; 1 = the program is built round an Option Reserve range over the window $4000-$7FFF
                        	   177: NTC_WINPAGED	equ 0		; 1 = page 0 code may sit under the window (Option Memory Paged, not Reserved): the Memory class ne
                        	   178: NTC_BUFSIZE	equ 2048		; the library's buffer (ntc_buf: FileSystem, Memory.Copy): Option Buffer
                        	   179: NTC_ISLN	equ 1		; interrupt classes (Option Class Interrupt): the slots ntc_isl has (8 bytes each)
                        	   180: NTC_INTS	equ 1		; 0 = the platform never lets interrupts in (;@ints 0: ntc_xn's safe point has no ei)
                        	   181: NTC_PLATRSV	equ 0		; 1 = the platform's fixed areas (;@reserved) are Reserved in the memory map: the build goes round t
                        	   182: NTC_CPMGFX	equ 0		; 1 = CP/M: Graphics draws on an Amstrad CPC's screen (2.2: $C000, Plus: block 1 from common memory)
                        	   183: NTC_RS		macro			; the real stack: the thread position kept in ntc_ip
                        	   184: 			tsx
                        	   185: 			stx ntc_ip
                        	   186: 			tsy
                        	   187: 			sty ntc_ip+1
                        	   188: 			ldx ntc_csp
                        	   189: 			txs
                        	   190: 			ldy ntc_csp+1
                        	   191: 			tys
                        	   192: 			endm
                        	   193: NTC_TS		macro			; back to the thread (A and the flags are kept)
                        	   194: 			ldx ntc_ip
                        	   195: 			txs
                        	   196: 			ldy ntc_ip+1
                        	   197: 			tys
                        	   198: 			endm
                        	   199: NTC_POP		macro			; the next thread word into the base page word \1
                        	   200: 			pla
                        	   201: 			sta \1
                        	   202: 			pla
                        	   203: 			sta \1+1
                        	   204: 			endm
