                        	  9180: ;## ntc_div
                        	  9181: ; z_a / z_b signed, truncating: z_a = quotient, z_b = remainder (the
                        	  9182: ; dividend's sign). Divide by zero: quotient 0, remainder = dividend.
                        	  9183: ; -32768 / -1: quotient -32768, remainder 0. JSR (the real stack). Uses z_c, z_t0, z_t1
                        	  9184: ntc_div:
00:9B6D A514            	  9185: 			lda z_b
00:9B6F 0515            	  9186: 			ora z_b+1
00:9B71 D00F            	  9187: 			bne ntc_div_nz
