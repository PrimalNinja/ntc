00:205D 8D1AD0          	    61: 			sta $D01A
00:2060 A9FF            	    62: 			lda #$FF
00:2062 8D19D0          	    63: 			sta $D019
00:2065 A903            	    64: 			lda #<ntc_m65_nmi			; vectors (RAM: no KERNAL mapped)
00:2067 8DFAFF          	    65: 			sta $FFFA
00:206A A921            	    66: 			lda #>ntc_m65_nmi
00:206C 8DFBFF          	    67: 			sta $FFFB
