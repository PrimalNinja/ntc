00:A8D5 CA              	 11048: 			dex
00:A8D6 D0F6            	 11049: 			bne ntc_zfb_page
                        	 11050: ntc_zfb_part:
00:A8D8 A412            	 11051: 			ldy z_a
00:A8DA F009            	 11052: 			beq ntc_zfb_end
00:A8DC A000            	 11053: 			ldy #0
                        	 11054: ntc_zfb_lp:
00:A8DE 9106            	 11055: 			sta (z_p0),y
00:A8E0 C8              	 11056: 			iny
00:A8E1 C412            	 11057: 			cpy z_a
00:A8E3 D0F9            	 11058: 			bne ntc_zfb_lp
                        	 11059: ntc_zfb_end:
00:A8E5 60              	 11060: 			rts
                        	 11061: 
                        	 11062: ;## ntc_plat_data
                        	 11063: VIC_SCRA	equ $0800		; graphics: the screen memory showing buffer A (and the console's)
                        	 11064: VIC_SCRB	equ $1000		; showing buffer B
                        	 11065: VIC_TXT		equ $1800		; graphics: the text layer's characters (40 x 25)
                        	 11066: VIC_TCOL	equ $1C00		; its colours
                        	 11067: VIC_DIRTY	equ $E800		; its cells to draw again: bit 0 into buffer A, bit 1 into B
00:A8E6 00              	 11068: ntc_vic_on:		db 0			; $80 = the graphics screen is on (Print goes to its text layer)
00:A8E7 01              	 11069: ntc_vic_pen:	db 1			; graphics: the text's colour (palette index)
00:A8E8 00              	 11070: ntc_curx:		db 0			; the cursor (0 based)
00:A8E9 00              	 11071: ntc_cury:		db 0
00:A8EA 50              	 11072: ntc_scols:		db 80			; the screen's size
00:A8EB 19              	 11073: ntc_srows:		db 25
00:A8EC 0000            	 11074: ntc_ticks:		dw 0			; frames since the start (the frame counter, followed)
00:A8EE 00              	 11075: ntc_m65_lfc:	db 0			; $D7FA last time it was looked at
00:A8EF 0000            	 11076: ntc_m65_brkpc:	dw 0			; BRK: the stack pointer then
00:A8F1 00              	 11077: ntc_m65_bkx:	db 0
00:A8F2 01              	 11078: ntc_m65_colour:	db 1			; the console's colour (white)
00:A8F3 0000            	 11079: ntc_m65_logn:	dw 0			; NTC_M65LOG: the log's length
                        	 11080: 
                        	 11081: ;## ntc_plat_screen ntc_plat_data ntc_data ntc_m65_far
                        	 11082: ; ------------------------------------------------------------
                        	 11083: ; the console: screen memory $0800 (ASCII), colours in colour RAM. JSR on
                        	 11084: ; the real stack; A, X, Y and the platform's base page ($50-$6F) are used.
                        	 11085: ; ------------------------------------------------------------
                        	 11086: ; ntc_plat_putc - A = character (32-126; others are shown as they are)
                        	 11087: ntc_plat_putc:
00:A8F5 8D7CAB          	 11088: 			sta ntc_m65_ch
                        	 11089: 			ifd NTC_M65LOG
                        	 11090: 			jsr ntc_m65_log
                        	 11091: 			endif
00:A8F8 2CE6A8          	 11092: 			bit ntc_vic_on
00:A8FB 1016            	 11093: 			bpl ntc_m65_pc_txt
00:A8FD 20B3A9          	 11094: 			jsr ntc_m65_txtcell			; graphics: into the text layer
00:A900 A000            	 11095: 			ldy #0
00:A902 AD7CAB          	 11096: 			lda ntc_m65_ch
00:A905 9150            	 11097: 			sta ($50),y
00:A907 ADE7A8          	 11098: 			lda ntc_vic_pen
00:A90A 9152            	 11099: 			sta ($52),y
00:A90C A903            	 11100: 			lda #3
00:A90E 9154            	 11101: 			sta ($54),y
00:A910 4C1EA9          	 11102: 			jmp ntc_m65_pc_adv
                        	 11103: ntc_m65_pc_txt:
00:A913 2096A9          	 11104: 			jsr ntc_m65_rowaddr			; $50 = the row's address
00:A916 ACE8A8          	 11105: 			ldy ntc_curx
00:A919 AD7CAB          	 11106: 			lda ntc_m65_ch
00:A91C 9150            	 11107: 			sta ($50),y
                        	 11108: ntc_m65_pc_adv:
00:A91E EEE8A8          	 11109: 			inc ntc_curx
00:A921 ADE8A8          	 11110: 			lda ntc_curx
00:A924 CDEAA8          	 11111: 			cmp ntc_scols
00:A927 9008            	 11112: 			bcc ntc_m65_pc_e
00:A929 A900            	 11113: 			lda #0						; past the end: the next line
00:A92B 8DE8A8          	 11114: 			sta ntc_curx
00:A92E 4C37A9          	 11115: 			jmp ntc_m65_down
                        	 11116: ntc_m65_pc_e:
00:A931 60              	 11117: 			rts
                        	 11118: 
                        	 11119: ; ntc_plat_newline
                        	 11120: ntc_plat_newline:
                        	 11121: 			ifd NTC_M65LOG
                        	 11122: 			lda #10
                        	 11123: 			jsr ntc_m65_log
                        	 11124: 			endif
00:A932 A900            	 11125: 			lda #0
00:A934 8DE8A8          	 11126: 			sta ntc_curx
                        	 11127: ; the cursor down a line, the screen up at the bottom
                        	 11128: ntc_m65_down:
00:A937 ADE9A8          	 11129: 			lda ntc_cury
00:A93A 18              	 11130: 			clc
00:A93B 6901            	 11131: 			adc #1
00:A93D CDEBA8          	 11132: 			cmp ntc_srows
00:A940 B004            	 11133: 			bcs ntc_m65_dn_end
00:A942 8DE9A8          	 11134: 			sta ntc_cury
00:A945 60              	 11135: 			rts
                        	 11136: ntc_m65_dn_end:
00:A946 2CE6A8          	 11137: 			bit ntc_vic_on				; graphics: no scrolling (the last row again)
00:A949 1001            	 11138: 			bpl ntc_m65_scroll
00:A94B 60              	 11139: 			rts
                        	 11140: ntc_m65_scroll:
                        	 11141: 			; rows 1 .. n-1 up a row (screen memory, then a blank last row)
00:A94C A900            	 11142: 			lda #<$0800
00:A94E 8550            	 11143: 			sta $50
00:A950 A908            	 11144: 			lda #>$0800
00:A952 8551            	 11145: 			sta $51
00:A954 ADEAA8          	 11146: 			lda ntc_scols
00:A957 18              	 11147: 			clc
00:A958 6900            	 11148: 			adc #<$0800
00:A95A 8552            	 11149: 			sta $52
00:A95C A908            	 11150: 			lda #>$0800
00:A95E 6900            	 11151: 			adc #0
00:A960 8553            	 11152: 			sta $53
00:A962 AEEBA8          	 11153: 			ldx ntc_srows
00:A965 CA              	 11154: 			dex
                        	 11155: ntc_m65_scr_r:
00:A966 A000            	 11156: 			ldy #0
                        	 11157: ntc_m65_scr_c:
00:A968 B152            	 11158: 			lda ($52),y
00:A96A 9150            	 11159: 			sta ($50),y
00:A96C C8              	 11160: 			iny
00:A96D CCEAA8          	 11161: 			cpy ntc_scols
00:A970 D0F6            	 11162: 			bne ntc_m65_scr_c
00:A972 A552            	 11163: 			lda $52
00:A974 8550            	 11164: 			sta $50
00:A976 A553            	 11165: 			lda $53
00:A978 8551            	 11166: 			sta $51
00:A97A A552            	 11167: 			lda $52
00:A97C 18              	 11168: 			clc
00:A97D 6DEAA8          	 11169: 			adc ntc_scols
00:A980 8552            	 11170: 			sta $52
00:A982 9002            	 11171: 			bcc ntc_m65_scr_n
00:A984 E653            	 11172: 			inc $53
                        	 11173: ntc_m65_scr_n:
00:A986 CA              	 11174: 			dex
00:A987 D0DD            	 11175: 			bne ntc_m65_scr_r
00:A989 A000            	 11176: 			ldy #0
00:A98B A920            	 11177: 			lda #' '
                        	 11178: ntc_m65_scr_b:
00:A98D 9150            	 11179: 			sta ($50),y
00:A98F C8              	 11180: 			iny
00:A990 CCEAA8          	 11181: 			cpy ntc_scols
00:A993 D0F8            	 11182: 			bne ntc_m65_scr_b
00:A995 60              	 11183: 			rts
                        	 11184: 
                        	 11185: ; $50/$51 = the address of the cursor's row in screen memory
                        	 11186: ntc_m65_rowaddr:
00:A996 A900            	 11187: 			lda #<$0800
00:A998 8550            	 11188: 			sta $50
00:A99A A908            	 11189: 			lda #>$0800
00:A99C 8551            	 11190: 			sta $51
00:A99E AEE9A8          	 11191: 			ldx ntc_cury
00:A9A1 F00F            	 11192: 			beq ntc_m65_ra_e
                        	 11193: ntc_m65_ra_l:
00:A9A3 A550            	 11194: 			lda $50
00:A9A5 18              	 11195: 			clc
00:A9A6 6DEAA8          	 11196: 			adc ntc_scols
00:A9A9 8550            	 11197: 			sta $50
00:A9AB 9002            	 11198: 			bcc ntc_m65_ra_n
00:A9AD E651            	 11199: 			inc $51
                        	 11200: ntc_m65_ra_n:
00:A9AF CA              	 11201: 			dex
00:A9B0 D0F1            	 11202: 			bne ntc_m65_ra_l
                        	 11203: ntc_m65_ra_e:
00:A9B2 60              	 11204: 			rts
                        	 11205: 
                        	 11206: ; $50 = the text layer's cell at the cursor, $52 its colour, $54 its dirty flags
                        	 11207: ntc_m65_txtcell:
00:A9B3 ADE9A8          	 11208: 			lda ntc_cury				; * 40 = * 32 + * 8
00:A9B6 8550            	 11209: 			sta $50
00:A9B8 A900            	 11210: 			lda #0
00:A9BA 8551            	 11211: 			sta $51
00:A9BC 0650            	 11212: 			asl $50
00:A9BE 2651            	 11213: 			rol $51
00:A9C0 0650            	 11214: 			asl $50
00:A9C2 2651            	 11215: 			rol $51
00:A9C4 0650            	 11216: 			asl $50
00:A9C6 2651            	 11217: 			rol $51
00:A9C8 A550            	 11218: 			lda $50
00:A9CA 8552            	 11219: 			sta $52
00:A9CC A551            	 11220: 			lda $51
00:A9CE 8553            	 11221: 			sta $53						; * 8
00:A9D0 0650            	 11222: 			asl $50
00:A9D2 2651            	 11223: 			rol $51
00:A9D4 0650            	 11224: 			asl $50
00:A9D6 2651            	 11225: 			rol $51						; * 32
00:A9D8 18              	 11226: 			clc
00:A9D9 A550            	 11227: 			lda $50
00:A9DB 6552            	 11228: 			adc $52
00:A9DD 8550            	 11229: 			sta $50
00:A9DF A551            	 11230: 			lda $51
00:A9E1 6553            	 11231: 			adc $53
00:A9E3 8551            	 11232: 			sta $51
00:A9E5 18              	 11233: 			clc
00:A9E6 A550            	 11234: 			lda $50
00:A9E8 6DE8A8          	 11235: 			adc ntc_curx
00:A9EB 8550            	 11236: 			sta $50
00:A9ED 8552            	 11237: 			sta $52
00:A9EF 8554            	 11238: 			sta $54
00:A9F1 A551            	 11239: 			lda $51
00:A9F3 6900            	 11240: 			adc #0
00:A9F5 8551            	 11241: 			sta $51						; the cell's number (the three tables are page aligned)
00:A9F7 18              	 11242: 			clc
00:A9F8 691C            	 11243: 			adc #>VIC_TCOL
00:A9FA 8553            	 11244: 			sta $53
00:A9FC A551            	 11245: 			lda $51
00:A9FE 18              	 11246: 			clc
00:A9FF 69E8            	 11247: 			adc #>VIC_DIRTY
00:AA01 8555            	 11248: 			sta $55
00:AA03 A551            	 11249: 			lda $51
00:AA05 18              	 11250: 			clc
00:AA06 6918            	 11251: 			adc #>VIC_TXT
00:AA08 8551            	 11252: 			sta $51
00:AA0A 60              	 11253: 			rts
                        	 11254: 
                        	 11255: ; ntc_plat_backspace - back a character and blank it
                        	 11256: ntc_plat_backspace:
00:AA0B ADE8A8          	 11257: 			lda ntc_curx
00:AA0E F006            	 11258: 			beq ntc_m65_bs_up
00:AA10 CEE8A8          	 11259: 			dec ntc_curx
00:AA13 4C25AA          	 11260: 			jmp ntc_m65_bs_blank
                        	 11261: ntc_m65_bs_up:
00:AA16 ADE9A8          	 11262: 			lda ntc_cury
00:AA19 F027            	 11263: 			beq ntc_m65_bs_e
00:AA1B CEE9A8          	 11264: 			dec ntc_cury
00:AA1E AEEAA8          	 11265: 			ldx ntc_scols
00:AA21 CA              	 11266: 			dex
00:AA22 8EE8A8          	 11267: 			stx ntc_curx
                        	 11268: ntc_m65_bs_blank:
00:AA25 2CE6A8          	 11269: 			bit ntc_vic_on
00:AA28 100E            	 11270: 			bpl ntc_m65_bs_t
00:AA2A 20B3A9          	 11271: 			jsr ntc_m65_txtcell
00:AA2D A000            	 11272: 			ldy #0
00:AA2F A920            	 11273: 			lda #' '
00:AA31 9150            	 11274: 			sta ($50),y
00:AA33 A903            	 11275: 			lda #3
00:AA35 9154            	 11276: 			sta ($54),y
00:AA37 60              	 11277: 			rts
                        	 11278: ntc_m65_bs_t:
00:AA38 2096A9          	 11279: 			jsr ntc_m65_rowaddr
00:AA3B ACE8A8          	 11280: 			ldy ntc_curx
00:AA3E A920            	 11281: 			lda #' '
00:AA40 9150            	 11282: 			sta ($50),y
                        	 11283: ntc_m65_bs_e:
00:AA42 60              	 11284: 			rts
                        	 11285: 
                        	 11286: ; ntc_plat_cls - blank screen, colours set, cursor home
                        	 11287: ntc_plat_cls:
00:AA43 2CE6A8          	 11288: 			bit ntc_vic_on
00:AA46 1052            	 11289: 			bpl ntc_m65_cls_t
00:AA48 A200            	 11290: 			ldx #0						; graphics: the text layer blank (a cell that had a
                        	 11291: ntc_m65_cls_g:							; character is drawn again: as a space)
00:AA4A BD0018          	 11292: 			lda VIC_TXT,x
00:AA4D C920            	 11293: 			cmp #' '
00:AA4F F00A            	 11294: 			beq ntc_m65_cls_g1
00:AA51 A903            	 11295: 			lda #3
00:AA53 9D00E8          	 11296: 			sta VIC_DIRTY,x
00:AA56 A920            	 11297: 			lda #' '
00:AA58 9D0018          	 11298: 			sta VIC_TXT,x
                        	 11299: ntc_m65_cls_g1:
00:AA5B BD0019          	 11300: 			lda VIC_TXT+$100,x
00:AA5E C920            	 11301: 			cmp #' '
00:AA60 F00A            	 11302: 			beq ntc_m65_cls_g2
00:AA62 A903            	 11303: 			lda #3
00:AA64 9D00E9          	 11304: 			sta VIC_DIRTY+$100,x
00:AA67 A920            	 11305: 			lda #' '
00:AA69 9D0019          	 11306: 			sta VIC_TXT+$100,x
                        	 11307: ntc_m65_cls_g2:
00:AA6C BD001A          	 11308: 			lda VIC_TXT+$200,x
00:AA6F C920            	 11309: 			cmp #' '
00:AA71 F00A            	 11310: 			beq ntc_m65_cls_g3
00:AA73 A903            	 11311: 			lda #3
00:AA75 9D00EA          	 11312: 			sta VIC_DIRTY+$200,x
00:AA78 A920            	 11313: 			lda #' '
00:AA7A 9D001A          	 11314: 			sta VIC_TXT+$200,x
                        	 11315: ntc_m65_cls_g3:
00:AA7D BD001B          	 11316: 			lda VIC_TXT+$300,x
00:AA80 C920            	 11317: 			cmp #' '
00:AA82 F00A            	 11318: 			beq ntc_m65_cls_g4
00:AA84 A903            	 11319: 			lda #3
00:AA86 9D00EB          	 11320: 			sta VIC_DIRTY+$300,x
00:AA89 A920            	 11321: 			lda #' '
00:AA8B 9D001B          	 11322: 			sta VIC_TXT+$300,x
                        	 11323: ntc_m65_cls_g4:
00:AA8E E8              	 11324: 			inx
00:AA8F D0B9            	 11325: 			bne ntc_m65_cls_g
00:AA91 A900            	 11326: 			lda #0
00:AA93 8DE8A8          	 11327: 			sta ntc_curx
00:AA96 8DE9A8          	 11328: 			sta ntc_cury
00:AA99 60              	 11329: 			rts
                        	 11330: ntc_m65_cls_t:
00:AA9A A900            	 11331: 			lda #<$0800
00:AA9C 8550            	 11332: 			sta $50
00:AA9E A908            	 11333: 			lda #>$0800
00:AAA0 8551            	 11334: 			sta $51
00:AAA2 A208            	 11335: 			ldx #8						; 8 x 256 = 2048 bytes (80 x 25 = 2000)
00:AAA4 A000            	 11336: 			ldy #0
00:AAA6 A920            	 11337: 			lda #' '
                        	 11338: ntc_m65_cls_l:
00:AAA8 9150            	 11339: 			sta ($50),y
00:AAAA C8              	 11340: 			iny
00:AAAB D0FB            	 11341: 			bne ntc_m65_cls_l
00:AAAD E651            	 11342: 			inc $51
00:AAAF CA              	 11343: 			dex
00:AAB0 D0F6            	 11344: 			bne ntc_m65_cls_l
                        	 11345: 			; colour RAM ($FF80000): 2000 bytes of the console's colour
00:AAB2 A900            	 11346: 			lda #$00
00:AAB4 8554            	 11347: 			sta $54
00:AAB6 A900            	 11348: 			lda #$00
00:AAB8 8555            	 11349: 			sta $55
00:AABA A9F8            	 11350: 			lda #$F8
00:AABC 8556            	 11351: 			sta $56
00:AABE A90F            	 11352: 			lda #$0F
00:AAC0 8557            	 11353: 			sta $57
00:AAC2 A208            	 11354: 			ldx #8
00:AAC4 A300            	 11355: 			ldz #0
00:AAC6 ADF2A8          	 11356: 			lda ntc_m65_colour
                        	 11357: ntc_m65_cls_c:
00:AAC9 EA9254          	 11358: 			sta [$54],z
00:AACC 1B              	 11359: 			inz
00:AACD D0FA            	 11360: 			bne ntc_m65_cls_c
00:AACF E655            	 11361: 			inc $55
00:AAD1 CA              	 11362: 			dex
00:AAD2 D0F5            	 11363: 			bne ntc_m65_cls_c
00:AAD4 A300            	 11364: 			ldz #0
00:AAD6 A900            	 11365: 			lda #0
00:AAD8 8DE8A8          	 11366: 			sta ntc_curx
00:AADB 8DE9A8          	 11367: 			sta ntc_cury
00:AADE 60              	 11368: 			rts
                        	 11369: 
                        	 11370: ; ntc_plat_mode - A = mode: 2 = 80 columns, else 40; clears the screen
                        	 11371: ntc_plat_mode:
00:AADF A200            	 11372: 			ldx #0						; (the graphics screen off: Mode is the console's)
00:AAE1 8EE6A8          	 11373: 			stx ntc_vic_on
00:AAE4 A250            	 11374: 			ldx #80
00:AAE6 C902            	 11375: 			cmp #2
00:AAE8 F002            	 11376: 			beq ntc_m65_md80
00:AAEA A228            	 11377: 			ldx #40
                        	 11378: ntc_m65_md80:
00:AAEC 8EEAA8          	 11379: 			stx ntc_scols
00:AAEF 8EF007          	 11380: 			stx $07F0
00:AAF2 A919            	 11381: 			lda #25
00:AAF4 8DEBA8          	 11382: 			sta ntc_srows
00:AAF7 8DF107          	 11383: 			sta $07F1
00:AAFA A947            	 11384: 			lda #$47					; (in case a program changed the I/O mode)
00:AAFC 8D2FD0          	 11385: 			sta $D02F
00:AAFF A953            	 11386: 			lda #$53
00:AB01 8D2FD0          	 11387: 			sta $D02F
00:AB04 A980            	 11388: 			lda #$80					; PAL (50 frames a second)
00:AB06 1C6FD0          	 11389: 			trb $D06F
00:AB09 A980            	 11390: 			lda #$80					; hot registers on while the legacy ones are set
00:AB0B 0C5DD0          	 11391: 			tsb $D05D
00:AB0E A91B            	 11392: 			lda #$1B					; text, display on, 25 rows
00:AB10 8D11D0          	 11393: 			sta $D011
00:AB13 A9C8            	 11394: 			lda #$C8					; 40 / 80 columns (80: scroll 1 - the VIC-III puts 80
00:AB15 E050            	 11395: 			cpx #80						; column text 2 pixels left of the border)
00:AB17 D002            	 11396: 			bne ntc_m65_md16
00:AB19 A9C9            	 11397: 			lda #$C9
                        	 11398: ntc_m65_md16:
00:AB1B 8D16D0          	 11399: 			sta $D016
00:AB1E A914            	 11400: 			lda #$14
00:AB20 8D18D0          	 11401: 			sta $D018
00:AB23 A940            	 11402: 			lda #$40					; FAST, 80 columns when asked
00:AB25 E050            	 11403: 			cpx #80
00:AB27 D002            	 11404: 			bne ntc_m65_md40
00:AB29 0980            	 11405: 			ora #$80
                        	 11406: ntc_m65_md40:
00:AB2B 8D31D0          	 11407: 			sta $D031
00:AB2E A940            	 11408: 			lda #$40					; VFAST, 8 bit characters (CHR16 / FCLR off)
00:AB30 8D54D0          	 11409: 			sta $D054
00:AB33 A980            	 11410: 			lda #$80					; hot registers off: the precise pointers stay
00:AB35 1C5DD0          	 11411: 			trb $D05D
00:AB38 A900            	 11412: 			lda #<$0800					; screen memory
00:AB3A 8D60D0          	 11413: 			sta $D060
00:AB3D A908            	 11414: 			lda #>$0800
00:AB3F 8D61D0          	 11415: 			sta $D061
00:AB42 A900            	 11416: 			lda #0
00:AB44 8D62D0          	 11417: 			sta $D062
00:AB47 AD63D0          	 11418: 			lda $D063
00:AB4A 29F0            	 11419: 			and #$F0
00:AB4C 8D63D0          	 11420: 			sta $D063
00:AB4F A900            	 11421: 			lda #<$E000					; the font
00:AB51 8D68D0          	 11422: 			sta $D068
00:AB54 A9E0            	 11423: 			lda #>$E000
00:AB56 8D69D0          	 11424: 			sta $D069
00:AB59 A900            	 11425: 			lda #0
00:AB5B 8D6AD0          	 11426: 			sta $D06A
00:AB5E A900            	 11427: 			lda #0						; colours from the start of colour RAM
00:AB60 8D64D0          	 11428: 			sta $D064
00:AB63 8D65D0          	 11429: 			sta $D065
00:AB66 4C43AA          	 11430: 			jmp ntc_plat_cls
                        	 11431: 
                        	 11432: ; ntc_plat_locate - X = column, Y = row (1 based; off the screen: not moved)
                        	 11433: ntc_plat_locate:
00:AB69 CA              	 11434: 			dex
00:AB6A ECEAA8          	 11435: 			cpx ntc_scols
00:AB6D B00C            	 11436: 			bcs ntc_m65_loc_e
00:AB6F 88              	 11437: 			dey
00:AB70 CCEBA8          	 11438: 			cpy ntc_srows
00:AB73 B006            	 11439: 			bcs ntc_m65_loc_e
00:AB75 8EE8A8          	 11440: 			stx ntc_curx
00:AB78 8CE9A8          	 11441: 			sty ntc_cury
                        	 11442: ntc_m65_loc_e:
00:AB7B 60              	 11443: 			rts
                        	 11444: 
                        	 11445: 			ifd NTC_M65LOG
                        	 11446: ; the log (test builds): A appended at $10000 + its length (bank 1), the length at $1FFFC
                        	 11447: ntc_m65_log:
                        	 11448: 			pha
                        	 11449: 			lda ntc_m65_logn
                        	 11450: 			sta $58
                        	 11451: 			lda ntc_m65_logn+1
                        	 11452: 			sta $59
                        	 11453: 			lda #1
                        	 11454: 			sta $5A
                        	 11455: 			lda #0
                        	 11456: 			sta $5B
                        	 11457: 			pla
                        	 11458: 			ldz #0
                        	 11459: 			sta [$58],z
                        	 11460: 			inc ntc_m65_logn
                        	 11461: 			bne ntc_m65_logend
                        	 11462: 			inc ntc_m65_logn+1
                        	 11463: ntc_m65_logend:
                        	 11464: 			lda #<$FFFC
                        	 11465: 			sta $58
                        	 11466: 			lda #>$FFFC
                        	 11467: 			sta $59
                        	 11468: 			lda #1
                        	 11469: 			sta $5A
                        	 11470: 			lda #0
                        	 11471: 			sta $5B
                        	 11472: 			ldz #0
                        	 11473: 			lda ntc_m65_logn
                        	 11474: 			sta [$58],z
                        	 11475: 			inz
                        	 11476: 			lda ntc_m65_logn+1
                        	 11477: 			sta [$58],z
                        	 11478: 			inz
                        	 11479: 			lda #0
                        	 11480: 			sta [$58],z
                        	 11481: 			ldz #0
                        	 11482: 			rts
                        	 11483: 			endif
                        	 11484: 
                        	 11485: ;## ntc_m65_far
                        	 11486: ; (the 32 bit pointers in the base page: $54-$57 colour RAM, $58-$5B the log)
00:AB7C 00              	 11487: ntc_m65_ch:		db 0
                        	 11488: 
                        	 11489: ;## ntc_plat_key ntc_plat_data ntc_plat_ticks
                        	 11490: ; ------------------------------------------------------------
                        	 11491: ; the keyboard: the hardware's ASCII queue ($D610)
                        	 11492: ; ------------------------------------------------------------
                        	 11493: ; ntc_plat_scankey - A = a key typed (taken from the queue) or 0, no wait
                        	 11494: ntc_plat_scankey:
00:AB7D 20B3AB          	 11495: 			jsr ntc_plat_ticks			; (keeps Ticks going in a key loop)
00:AB80 AD10D6          	 11496: 			lda $D610
00:AB83 F025            	 11497: 			beq ntc_m65_sk_e
00:AB85 8D10D6          	 11498: 			sta $D610					; (any write takes it off the queue)
00:AB88 C914            	 11499: 			cmp #20						; DEL
00:AB8A D003            	 11500: 			bne ntc_m65_sk1
00:AB8C A908            	 11501: 			lda #8
00:AB8E 60              	 11502: 			rts
                        	 11503: ntc_m65_sk1:
00:AB8F C991            	 11504: 			cmp #145					; cursor up
00:AB91 D003            	 11505: 			bne ntc_m65_sk2
00:AB93 A9F0            	 11506: 			lda #$F0
00:AB95 60              	 11507: 			rts
                        	 11508: ntc_m65_sk2:
00:AB96 C911            	 11509: 			cmp #17						; down
00:AB98 D003            	 11510: 			bne ntc_m65_sk3
00:AB9A A9F1            	 11511: 			lda #$F1
00:AB9C 60              	 11512: 			rts
                        	 11513: ntc_m65_sk3:
00:AB9D C99D            	 11514: 			cmp #157					; left
00:AB9F D003            	 11515: 			bne ntc_m65_sk4
00:ABA1 A9F2            	 11516: 			lda #$F2
00:ABA3 60              	 11517: 			rts
                        	 11518: ntc_m65_sk4:
00:ABA4 C91D            	 11519: 			cmp #29						; right
00:ABA6 D002            	 11520: 			bne ntc_m65_sk_e
00:ABA8 A9F3            	 11521: 			lda #$F3
                        	 11522: ntc_m65_sk_e:
00:ABAA 60              	 11523: 			rts
                        	 11524: 
                        	 11525: ; ntc_plat_getkey - A = the next key (waits)
                        	 11526: ntc_plat_getkey:
00:ABAB 207DAB          	 11527: 			jsr ntc_plat_scankey
00:ABAE C900            	 11528: 			cmp #0
00:ABB0 F0F9            	 11529: 			beq ntc_plat_getkey
00:ABB2 60              	 11530: 			rts
                        	 11531: 
                        	 11532: ;## ntc_plat_ticks ntc_plat_data
                        	 11533: ; ntc_plat_ticks - the frame counter followed into ntc_ticks: A = low, X = high
                        	 11534: ntc_plat_ticks:
00:ABB3 ADFAD7          	 11535: 			lda $D7FA
00:ABB6 AA              	 11536: 			tax
00:ABB7 38              	 11537: 			sec
00:ABB8 EDEEA8          	 11538: 			sbc ntc_m65_lfc
00:ABBB 8EEEA8          	 11539: 			stx ntc_m65_lfc
00:ABBE 18              	 11540: 			clc
00:ABBF 6DECA8          	 11541: 			adc ntc_ticks
00:ABC2 8DECA8          	 11542: 			sta ntc_ticks
00:ABC5 9003            	 11543: 			bcc ntc_m65_tk_e
00:ABC7 EEEDA8          	 11544: 			inc ntc_ticks+1
                        	 11545: ntc_m65_tk_e:
00:ABCA ADECA8          	 11546: 			lda ntc_ticks
00:ABCD AEEDA8          	 11547: 			ldx ntc_ticks+1
00:ABD0 60              	 11548: 			rts
                        	 11549: 
                        	 11550: ;## ntc_plat_frame ntc_plat_ticks
                        	 11551: ; ntc_plat_frame - wait for the next frame (the frame counter moving on)
                        	 11552: ntc_plat_frame:
00:ABD1 20B3AB          	 11553: 			jsr ntc_plat_ticks
00:ABD4 ADFAD7          	 11554: 			lda $D7FA
                        	 11555: ntc_m65_fr_w:
00:ABD7 CDFAD7          	 11556: 			cmp $D7FA
00:ABDA F0FB            	 11557: 			beq ntc_m65_fr_w
00:ABDC 4CB3AB          	 11558: 			jmp ntc_plat_ticks
                        	 11559: 
                        	 11560: ;## ntc_plat_exit ntc_plat_data
                        	 11561: ; ntc_plat_exit - End: the console stays, the end marked for the test tools
                        	 11562: ntc_plat_exit:
00:ABDF A9A5            	 11563: 			lda #$A5
00:ABE1 8DF207          	 11564: 			sta $07F2
00:ABE4 60              	 11565: 			rts
                        	 11566: ntc_plat_exit_stop:
00:ABE5 20DFAB          	 11567: 			jsr ntc_plat_exit
                        	 11568: ntc_m65_halt:
00:ABE8 4CE8AB          	 11569: 			jmp ntc_m65_halt
                        	 11570: 
                        	 11571: ;## ntc_vic ntc_plat_data ntc_plat_screen ntc_plat_frame ntc_m65_far
                        	 11572: ; ------------------------------------------------------------
                        	 11573: ; The graphics screen (the Vic class): 320 x 200, 256 colours, two buffers.
                        	 11574: ; Each buffer is 1000 full colour characters (64 bytes each, a pixel a byte):
                        	 11575: ; buffer A at $40000 (characters $1000-$13E7, shown by screen memory $0800),
                        	 11576: ; buffer B at $50000 ($1400-$17E7, screen memory $1000). Character (column c,
                        	 11577: ; row r) is c * 25 + r, so a column of 8 pixels runs down the screen without a
                        	 11578: ; break: pixel (x, y) is at (x >> 3) * 1600 + y * 8 + (x & 7).
                        	 11579: ; Vic.Update draws the next picture into the buffer not shown - the playfield
                        	 11580: ; (columns 0 .. ntc_vic_fw - 1) cleared, the stars, the sprites (79 first, so
                        	 11581: ; sprite 0 is in front), the text layer - then waits for the frame and shows it.
                        	 11582: ; The panel (columns ntc_vic_fw .. 39) is not cleared: its text is drawn when it
                        	 11583: ; changes (into each buffer once), opaque, and Vic.Stamp / Vic.Box draw into both.
                        	 11584: ; Images: w, h (pixels, h even, 32 at most), then w columns of h / 2 bytes: two
                        	 11585: ; pixels a byte (the low nibble the upper), 0 = clear, 1-15 = colour + the
                        	 11586: ; sprite's palette * 16 + 16.
                        	 11587: ; Sprites (8 bytes each): x (16 bits, signed), y, image, attributes (bit 0 flip
                        	 11588: ; x, bit 1 flip y, bits 4-5 the palette), shown (0 / 1), 0.
                        	 11589: ; Uses $50-$6F (the platform's base page).
                        	 11590: ; ------------------------------------------------------------
                        	 11591: VIC_NSPR	equ 80
00:ABEB 20              	 11592: ntc_vic_fw:		db 32			; the playfield's width in columns (8 pixels)
00:ABEC 0001            	 11593: ntc_vic_fpx:	dw 256			; ... in pixels
00:ABEE 01              	 11594: ntc_vic_back:	db 1			; the buffer being drawn: 0 A, 1 B
00:ABEF 00              	 11595: ntc_vic_bg:		db 0			; the playfield's colour
00:ABF0 00              	 11596: ntc_vic_paper:	db 0			; the panel text's background
00:ABF1 0000            	 11597: ntc_vic_imgs:	dw 0			; the image table: an address for each image
00:ABF3 00              	 11598: ntc_vic_starn:	db 0			; stars
00:ABF4 00              	 11599: ntc_vic_spn:	db 0			; (the sprite loop's count)
00:ABF5 00              	 11600: ntc_vic_noflip:	db 0			; 1: Vic.Draw (drawn into the back buffer, not shown)
00:ABF6 00              	 11601: ntc_vic_stary:	db 0			; their scroll (added to each star's y)
00:ABF7 00              	 11602: ntc_vic_sat:	ds VIC_NSPR*8
00:ABF8 *
00:AE77 00              	 11603: ntc_vic_sx:		ds 64			; the stars: x, y, colour
00:AE78 *
00:AEB7 00              	 11604: ntc_vic_sy:		ds 64
00:AEB8 *
00:AEF7 00              	 11605: ntc_vic_sc:		ds 64
00:AEF8 *
                        	 11606: ; the columns' offsets: c * 1600
00:AF37 00              	 11607: ntc_vic_cbl:	db <0, <1600, <3200, <4800, <6400, <8000, <9600, <11200, <12800, <14400
00:AF38 40
00:AF39 80
00:AF3A C0
00:AF3B 00
00:AF3C 40
00:AF3D 80
00:AF3E C0
00:AF3F 00
00:AF40 40
00:AF41 80              	 11608: 				db <16000, <17600, <19200, <20800, <22400, <24000, <25600, <27200, <28800, <30400
00:AF42 C0
00:AF43 00
00:AF44 40
00:AF45 80
00:AF46 C0
00:AF47 00
00:AF48 40
00:AF49 80
00:AF4A C0
00:AF4B 00              	 11609: 				db <32000, <33600, <35200, <36800, <38400, <40000, <41600, <43200, <44800, <46400
00:AF4C 40
00:AF4D 80
00:AF4E C0
00:AF4F 00
00:AF50 40
00:AF51 80
00:AF52 C0
00:AF53 00
00:AF54 40
00:AF55 80              	 11610: 				db <48000, <49600, <51200, <52800, <54400, <56000, <57600, <59200, <60800, <62400, <64000
00:AF56 C0
00:AF57 00
00:AF58 40
00:AF59 80
00:AF5A C0
00:AF5B 00
00:AF5C 40
00:AF5D 80
00:AF5E C0
00:AF5F 00
00:AF60 00              	 11611: ntc_vic_cbh:	db >0, >1600, >3200, >4800, >6400, >8000, >9600, >11200, >12800, >14400
00:AF61 06
00:AF62 0C
00:AF63 12
00:AF64 19
00:AF65 1F
00:AF66 25
00:AF67 2B
00:AF68 32
00:AF69 38
00:AF6A 3E              	 11612: 				db >16000, >17600, >19200, >20800, >22400, >24000, >25600, >27200, >28800, >30400
00:AF6B 44
00:AF6C 4B
00:AF6D 51
00:AF6E 57
00:AF6F 5D
00:AF70 64
00:AF71 6A
00:AF72 70
00:AF73 76
00:AF74 7D              	 11613: 				db >32000, >33600, >35200, >36800, >38400, >40000, >41600, >43200, >44800, >46400
00:AF75 83
00:AF76 89
00:AF77 8F
00:AF78 96
00:AF79 9C
00:AF7A A2
00:AF7B A8
00:AF7C AF
00:AF7D B5
00:AF7E BB              	 11614: 				db >48000, >49600, >51200, >52800, >54400, >56000, >57600, >59200, >60800, >62400, >64000
00:AF7F C1
00:AF80 C8
00:AF81 CE
00:AF82 D4
00:AF83 DA
00:AF84 E1
00:AF85 E7
00:AF86 ED
00:AF87 F3
00:AF88 FA
                        	 11615: ; a DMA fill job (F018B, enhanced): count, the byte, the destination
                        	 11616: ntc_vic_dmal:
00:AF89 0B              	 11617: 			db $0B						; F018B
00:AF8A 81              	 11618: 			db $81, $00					; destination MB 0
00:AF8B 00
00:AF8C 00              	 11619: 			db $00						; end of options
00:AF8D 03              	 11620: 			db $03						; fill
00:AF8E 0000            	 11621: ntc_vic_dmac:	dw 0				; count
00:AF90 00              	 11622: ntc_vic_dmav:	db 0, 0				; the byte (the source's low byte)
00:AF91 00
00:AF92 00              	 11623: 			db 0						; source bank
00:AF93 0000            	 11624: ntc_vic_dmad:	dw 0				; destination
00:AF95 04              	 11625: ntc_vic_dmab:	db 4				; destination bank
00:AF96 00              	 11626: 			db 0						; command (high)
00:AF97 0000            	 11627: 			dw 0						; modulo
                        	 11628: 
                        	 11629: ; ntc_vic_fill - DMA fill: $5C/$5D = the start (in the bank), $5E/$5F = bytes, A = the
                        	 11630: ; byte, X = the bank
                        	 11631: ntc_vic_fill:
00:AF99 8D90AF          	 11632: 			sta ntc_vic_dmav
00:AF9C 8E95AF          	 11633: 			stx ntc_vic_dmab
00:AF9F A55C            	 11634: 			lda $5C
00:AFA1 8D93AF          	 11635: 			sta ntc_vic_dmad
00:AFA4 A55D            	 11636: 			lda $5D
00:AFA6 8D94AF          	 11637: 			sta ntc_vic_dmad+1
00:AFA9 A55E            	 11638: 			lda $5E
00:AFAB 8D8EAF          	 11639: 			sta ntc_vic_dmac
00:AFAE A55F            	 11640: 			lda $5F
00:AFB0 8D8FAF          	 11641: 			sta ntc_vic_dmac+1
00:AFB3 055E            	 11642: 			ora $5E
00:AFB5 F012            	 11643: 			beq ntc_vic_fl_e
00:AFB7 A900            	 11644: 			lda #0
00:AFB9 8D02D7          	 11645: 			sta $D702					; the job's bank and MB
00:AFBC 8D04D7          	 11646: 			sta $D704
00:AFBF A9AF            	 11647: 			lda #>ntc_vic_dmal
00:AFC1 8D01D7          	 11648: 			sta $D701
00:AFC4 A989            	 11649: 			lda #<ntc_vic_dmal
00:AFC6 8D05D7          	 11650: 			sta $D705					; go (enhanced)
                        	 11651: ntc_vic_fl_e:
00:AFC9 60              	 11652: 			rts
                        	 11653: 
                        	 11654: ; ntc_vic_screen - A = 1: the graphics screen on (both buffers cleared, the text layer
                        	 11655: ; blank), 0: off (the console, 80 columns)
                        	 11656: ntc_vic_screen:
00:AFCA C900            	 11657: 			cmp #0
00:AFCC D005            	 11658: 			bne ntc_vic_son
00:AFCE A902            	 11659: 			lda #2
00:AFD0 4CDFAA          	 11660: 			jmp ntc_plat_mode
                        	 11661: ntc_vic_son:
00:AFD3 A947            	 11662: 			lda #$47
00:AFD5 8D2FD0          	 11663: 			sta $D02F
00:AFD8 A953            	 11664: 			lda #$53
00:AFDA 8D2FD0          	 11665: 			sta $D02F
                        	 11666: 			; the screen memories: cell (c, r) at (r * 40 + c) * 2 = $1000 / $1400 + c * 25 + r
00:AFDD A900            	 11667: 			lda #<VIC_SCRA
00:AFDF 8550            	 11668: 			sta $50
00:AFE1 A908            	 11669: 			lda #>VIC_SCRA
00:AFE3 8551            	 11670: 			sta $51
00:AFE5 A900            	 11671: 			lda #<VIC_SCRB
00:AFE7 8552            	 11672: 			sta $52
00:AFE9 A910            	 11673: 			lda #>VIC_SCRB
00:AFEB 8553            	 11674: 			sta $53
00:AFED A900            	 11675: 			lda #0
00:AFEF 8556            	 11676: 			sta $56						; row
                        	 11677: ntc_vic_sm_r:
00:AFF1 A556            	 11678: 			lda $56						; the row's first character: $1000 + r
00:AFF3 8558            	 11679: 			sta $58
00:AFF5 A910            	 11680: 			lda #$10
00:AFF7 8559            	 11681: 			sta $59
00:AFF9 A228            	 11682: 			ldx #40
00:AFFB A000            	 11683: 			ldy #0
                        	 11684: ntc_vic_sm_c:
00:AFFD A558            	 11685: 			lda $58
00:AFFF 9150            	 11686: 			sta ($50),y
00:B001 9152            	 11687: 			sta ($52),y
00:B003 C8              	 11688: 			iny
00:B004 A559            	 11689: 			lda $59
00:B006 9150            	 11690: 			sta ($50),y
00:B008 18              	 11691: 			clc
00:B009 6904            	 11692: 			adc #4						; buffer B: + $400
00:B00B 9152            	 11693: 			sta ($52),y
00:B00D C8              	 11694: 			iny
00:B00E 18              	 11695: 			clc
00:B00F A558            	 11696: 			lda $58
00:B011 6919            	 11697: 			adc #25
00:B013 8558            	 11698: 			sta $58
00:B015 9002            	 11699: 			bcc ntc_vic_sm_n
00:B017 E659            	 11700: 			inc $59
                        	 11701: ntc_vic_sm_n:
00:B019 CA              	 11702: 			dex
00:B01A D0E1            	 11703: 			bne ntc_vic_sm_c
00:B01C 18              	 11704: 			clc							; the next row: + 80 bytes
00:B01D A550            	 11705: 			lda $50
00:B01F 6950            	 11706: 			adc #80
00:B021 8550            	 11707: 			sta $50
00:B023 9002            	 11708: 			bcc ntc_vic_sm_1
00:B025 E651            	 11709: 			inc $51
                        	 11710: ntc_vic_sm_1:
00:B027 18              	 11711: 			clc
00:B028 A552            	 11712: 			lda $52
00:B02A 6950            	 11713: 			adc #80
00:B02C 8552            	 11714: 			sta $52
00:B02E 9002            	 11715: 			bcc ntc_vic_sm_2
00:B030 E653            	 11716: 			inc $53
                        	 11717: ntc_vic_sm_2:
00:B032 E656            	 11718: 			inc $56
00:B034 A556            	 11719: 			lda $56
00:B036 C919            	 11720: 			cmp #25
00:B038 D0B7            	 11721: 			bne ntc_vic_sm_r
                        	 11722: 			; colour RAM: 2000 bytes of 0
00:B03A A900            	 11723: 			lda #$00
00:B03C 8554            	 11724: 			sta $54
00:B03E 8555            	 11725: 			sta $55
00:B040 A9F8            	 11726: 			lda #$F8
00:B042 8556            	 11727: 			sta $56
