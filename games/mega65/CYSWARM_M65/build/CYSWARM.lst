                        	 12793: ;## ntc_sid ntc_plat_data
                        	 12794: ; ------------------------------------------------------------
                        	 12795: ; The Sid class's engine: 4 channels (3 tones on SID 1's voices, a noise on SID
                        	 12796: ; 2's voice 1) as sound effects that move on a frame at a time (ntc_sid_update,
                        	 12797: ; from Sid.Update): a period (the Mega Drive PSG's: 3579545 / 32 / period Hz)
                        	 12798: ; that slides and a volume that fades (the voice's sustain level). A channel:
                        	 12799: ; active, -, period, slide, volume, -, frames, left (12 bytes). Uses $50-$5F.
                        	 12800: ; ------------------------------------------------------------
00:B767 00              	 12801: ntc_sidch:		ds 4*12
00:B768 *
00:B797 00              	 12802: ntc_sid_regs:	db $00, $07, $0E, $20		; each channel's voice: $D400 + this
00:B798 07
00:B799 0E
00:B79A 20
00:B79B 00              	 12803: ntc_sid_init:	db 0						; the SIDs set up (volume, pulse widths)
                        	 12804: 
                        	 12805: ; the SIDs' volume up and the voices' pulse width a half (once)
                        	 12806: ntc_sid_setup:
00:B79C AD9BB7          	 12807: 			lda ntc_sid_init
00:B79F D020            	 12808: 			bne ntc_sid_su_e
00:B7A1 EE9BB7          	 12809: 			inc ntc_sid_init
00:B7A4 A90F            	 12810: 			lda #$0F
00:B7A6 8D18D4          	 12811: 			sta $D418
00:B7A9 8D38D4          	 12812: 			sta $D438
00:B7AC A203            	 12813: 			ldx #3
                        	 12814: ntc_sid_su_l:
00:B7AE BC97B7          	 12815: 			ldy ntc_sid_regs,x
00:B7B1 A900            	 12816: 			lda #0
00:B7B3 9902D4          	 12817: 			sta $D402,y
00:B7B6 9905D4          	 12818: 			sta $D405,y					; attack, decay: 0
00:B7B9 A908            	 12819: 			lda #8
00:B7BB 9903D4          	 12820: 			sta $D403,y					; pulse width $800: a square
00:B7BE CA              	 12821: 			dex
00:B7BF 10ED            	 12822: 			bpl ntc_sid_su_l
                        	 12823: ntc_sid_su_e:
00:B7C1 60              	 12824: 			rts
                        	 12825: 
                        	 12826: ; ntc_sid_on - A = the channel, X = its state (12 * channel): started (gated again)
                        	 12827: ntc_sid_on:
00:B7C2 855F            	 12828: 			sta $5F
00:B7C4 865E            	 12829: 			stx $5E
00:B7C6 209CB7          	 12830: 			jsr ntc_sid_setup
00:B7C9 A65F            	 12831: 			ldx $5F
00:B7CB BC97B7          	 12832: 			ldy ntc_sid_regs,x
00:B7CE A900            	 12833: 			lda #0						; gate off, then on (attack again)
00:B7D0 9904D4          	 12834: 			sta $D404,y
00:B7D3 A65E            	 12835: 			ldx $5E
00:B7D5 2005B8          	 12836: 			jsr ntc_sid_out
00:B7D8 A65F            	 12837: 			ldx $5F
00:B7DA BC97B7          	 12838: 			ldy ntc_sid_regs,x
00:B7DD A941            	 12839: 			lda #$41					; pulse, gate
00:B7DF E003            	 12840: 			cpx #3
00:B7E1 D002            	 12841: 			bne ntc_sid_on1
00:B7E3 A981            	 12842: 			lda #$81					; noise, gate
                        	 12843: ntc_sid_on1:
00:B7E5 9904D4          	 12844: 			sta $D404,y
00:B7E8 60              	 12845: 			rts
                        	 12846: 
                        	 12847: ; ntc_sid_off - A = the channel: silent, not active
                        	 12848: ntc_sid_off:
00:B7E9 AA              	 12849: 			tax
00:B7EA BC97B7          	 12850: 			ldy ntc_sid_regs,x
00:B7ED A900            	 12851: 			lda #0
00:B7EF 9904D4          	 12852: 			sta $D404,y					; gate off (release 0)
00:B7F2 9906D4          	 12853: 			sta $D406,y					; sustain 0
00:B7F5 8A              	 12854: 			txa
00:B7F6 0A              	 12855: 			asl
00:B7F7 0A              	 12856: 			asl
00:B7F8 855D            	 12857: 			sta $5D
00:B7FA 0A              	 12858: 			asl
00:B7FB 18              	 12859: 			clc
00:B7FC 655D            	 12860: 			adc $5D
00:B7FE AA              	 12861: 			tax
00:B7FF A900            	 12862: 			lda #0
00:B801 9D67B7          	 12863: 			sta ntc_sidch,x
00:B804 60              	 12864: 			rts
                        	 12865: 
                        	 12866: ; ntc_sid_out - $5F = the channel, X = its state: the frequency and the volume to the SID
                        	 12867: ntc_sid_out:
00:B805 865E            	 12868: 			stx $5E
00:B807 A45F            	 12869: 			ldy $5F
00:B809 C003            	 12870: 			cpy #3
00:B80B F035            	 12871: 			beq ntc_sid_o_noise
                        	 12872: 			; frequency = 1904665 / period
00:B80D BD69B7          	 12873: 			lda ntc_sidch+2,x
00:B810 855A            	 12874: 			sta $5A
00:B812 BD6AB7          	 12875: 			lda ntc_sidch+3,x
00:B815 855B            	 12876: 			sta $5B
00:B817 A919            	 12877: 			lda #$19
00:B819 855C            	 12878: 			sta $5C
00:B81B A910            	 12879: 			lda #$10
00:B81D 855D            	 12880: 			sta $5D
00:B81F A91D            	 12881: 			lda #$1D
00:B821 8556            	 12882: 			sta $56
00:B823 20C7B8          	 12883: 			jsr ntc_sid_div				; $5C/$5D/$56 / $5A/$5B
00:B826 A556            	 12884: 			lda $56						; past 16 bits: the top
00:B828 F006            	 12885: 			beq ntc_sid_o_f
00:B82A A9FF            	 12886: 			lda #$FF
00:B82C 855C            	 12887: 			sta $5C
00:B82E 855D            	 12888: 			sta $5D
                        	 12889: ntc_sid_o_f:
00:B830 A65F            	 12890: 			ldx $5F
00:B832 BC97B7          	 12891: 			ldy ntc_sid_regs,x
00:B835 A55C            	 12892: 			lda $5C
00:B837 9900D4          	 12893: 			sta $D400,y
00:B83A A55D            	 12894: 			lda $5D
00:B83C 9901D4          	 12895: 			sta $D401,y
00:B83F 4C64B8          	 12896: 			jmp ntc_sid_o_vol
                        	 12897: ntc_sid_o_noise:
00:B842 BD69B7          	 12898: 			lda ntc_sidch+2,x			; the kind: 0 high, 1 middle, 2 low, 3 channel 2's
00:B845 2903            	 12899: 			and #3
00:B847 A8              	 12900: 			tay
00:B848 B9C3B8          	 12901: 			lda ntc_sid_nhi,y
00:B84B D00F            	 12902: 			bne ntc_sid_o_n1
00:B84D AD0FD4          	 12903: 			lda $D40F					; (channel 2's frequency)
00:B850 8D21D4          	 12904: 			sta $D421
00:B853 AD0ED4          	 12905: 			lda $D40E
00:B856 8D20D4          	 12906: 			sta $D420
00:B859 4C64B8          	 12907: 			jmp ntc_sid_o_vol
                        	 12908: ntc_sid_o_n1:
00:B85C 8D21D4          	 12909: 			sta $D421
00:B85F A900            	 12910: 			lda #0
00:B861 8D20D4          	 12911: 			sta $D420
                        	 12912: ntc_sid_o_vol:
                        	 12913: 			; the volume now: volume * left / frames (frames 0: the volume)
00:B864 A65E            	 12914: 			ldx $5E
00:B866 BD6DB7          	 12915: 			lda ntc_sidch+6,x
00:B869 8557            	 12916: 			sta $57						; the volume
00:B86B BD6FB7          	 12917: 			lda ntc_sidch+8,x
00:B86E 1D70B7          	 12918: 			ora ntc_sidch+9,x
00:B871 F03D            	 12919: 			beq ntc_sid_o_v
00:B873 BD6FB7          	 12920: 			lda ntc_sidch+8,x			; divisor: frames
00:B876 855A            	 12921: 			sta $5A
00:B878 BD70B7          	 12922: 			lda ntc_sidch+9,x
00:B87B 855B            	 12923: 			sta $5B
                        	 12924: 			; volume * left (15 * 65535 at most: 24 bits)
00:B87D BD71B7          	 12925: 			lda ntc_sidch+10,x
00:B880 8550            	 12926: 			sta $50
00:B882 BD72B7          	 12927: 			lda ntc_sidch+11,x
00:B885 8551            	 12928: 			sta $51
00:B887 A900            	 12929: 			lda #0
00:B889 855C            	 12930: 			sta $5C
00:B88B 855D            	 12931: 			sta $5D
00:B88D 8556            	 12932: 			sta $56
00:B88F A457            	 12933: 			ldy $57
00:B891 F01D            	 12934: 			beq ntc_sid_o_v
                        	 12935: ntc_sid_o_m:
00:B893 18              	 12936: 			clc
00:B894 A55C            	 12937: 			lda $5C
00:B896 6550            	 12938: 			adc $50
00:B898 855C            	 12939: 			sta $5C
00:B89A A55D            	 12940: 			lda $5D
00:B89C 6551            	 12941: 			adc $51
00:B89E 855D            	 12942: 			sta $5D
00:B8A0 A556            	 12943: 			lda $56
00:B8A2 6900            	 12944: 			adc #0
00:B8A4 8556            	 12945: 			sta $56
00:B8A6 88              	 12946: 			dey
00:B8A7 D0EA            	 12947: 			bne ntc_sid_o_m
00:B8A9 20C7B8          	 12948: 			jsr ntc_sid_div
00:B8AC A55C            	 12949: 			lda $5C
00:B8AE 8557            	 12950: 			sta $57
                        	 12951: ntc_sid_o_v:
00:B8B0 A557            	 12952: 			lda $57						; the sustain level
00:B8B2 290F            	 12953: 			and #$0F
00:B8B4 0A              	 12954: 			asl
00:B8B5 0A              	 12955: 			asl
00:B8B6 0A              	 12956: 			asl
00:B8B7 0A              	 12957: 			asl
00:B8B8 A65F            	 12958: 			ldx $5F
00:B8BA BC97B7          	 12959: 			ldy ntc_sid_regs,x
00:B8BD 9906D4          	 12960: 			sta $D406,y
00:B8C0 A65E            	 12961: 			ldx $5E
00:B8C2 60              	 12962: 			rts
00:B8C3 30              	 12963: ntc_sid_nhi:	db $30, $18, $0C, 0
00:B8C4 18
00:B8C5 0C
00:B8C6 00
                        	 12964: 
                        	 12965: ; $5C/$5D/$56 (24 bits) / $5A/$5B: the quotient in $5C/$5D/$56, the remainder in $58/$59
                        	 12966: ntc_sid_div:
00:B8C7 A900            	 12967: 			lda #0
00:B8C9 8558            	 12968: 			sta $58
00:B8CB 8559            	 12969: 			sta $59
00:B8CD A218            	 12970: 			ldx #24
                        	 12971: ntc_sid_dv_l:
00:B8CF 065C            	 12972: 			asl $5C
00:B8D1 265D            	 12973: 			rol $5D
00:B8D3 2656            	 12974: 			rol $56
00:B8D5 2658            	 12975: 			rol $58
00:B8D7 2659            	 12976: 			rol $59
00:B8D9 A558            	 12977: 			lda $58
00:B8DB 38              	 12978: 			sec
00:B8DC E55A            	 12979: 			sbc $5A
00:B8DE A8              	 12980: 			tay
00:B8DF A559            	 12981: 			lda $59
00:B8E1 E55B            	 12982: 			sbc $5B
00:B8E3 9006            	 12983: 			bcc ntc_sid_dv_n
00:B8E5 8559            	 12984: 			sta $59
00:B8E7 8458            	 12985: 			sty $58
00:B8E9 E65C            	 12986: 			inc $5C
                        	 12987: ntc_sid_dv_n:
00:B8EB CA              	 12988: 			dex
00:B8EC D0E1            	 12989: 			bne ntc_sid_dv_l
00:B8EE 60              	 12990: 			rts
                        	 12991: 
                        	 12992: ; ntc_sid_update - every active channel a frame on
                        	 12993: ntc_sid_update:
00:B8EF A900            	 12994: 			lda #0
00:B8F1 855F            	 12995: 			sta $5F						; the channel
                        	 12996: ntc_sid_u_l:
00:B8F3 A55F            	 12997: 			lda $5F
00:B8F5 0A              	 12998: 			asl
00:B8F6 0A              	 12999: 			asl
00:B8F7 855D            	 13000: 			sta $5D
00:B8F9 0A              	 13001: 			asl
00:B8FA 18              	 13002: 			clc
00:B8FB 655D            	 13003: 			adc $5D
00:B8FD AA              	 13004: 			tax
00:B8FE BD67B7          	 13005: 			lda ntc_sidch,x
00:B901 F06B            	 13006: 			beq ntc_sid_u_n
00:B903 BD6FB7          	 13007: 			lda ntc_sidch+8,x			; frames: 0 = held until stopped
00:B906 1D70B7          	 13008: 			ora ntc_sidch+9,x
00:B909 F020            	 13009: 			beq ntc_sid_u_sl
00:B90B BD71B7          	 13010: 			lda ntc_sidch+10,x			; left - 1
00:B90E D003            	 13011: 			bne ntc_sid_u_d
00:B910 DE72B7          	 13012: 			dec ntc_sidch+11,x
                        	 13013: ntc_sid_u_d:
00:B913 DE71B7          	 13014: 			dec ntc_sidch+10,x
00:B916 BD71B7          	 13015: 			lda ntc_sidch+10,x
00:B919 1D72B7          	 13016: 			ora ntc_sidch+11,x
00:B91C F005            	 13017: 			beq ntc_sid_u_off
00:B91E BD72B7          	 13018: 			lda ntc_sidch+11,x			; (gone below 0: off too)
00:B921 1008            	 13019: 			bpl ntc_sid_u_sl
                        	 13020: ntc_sid_u_off:
00:B923 A55F            	 13021: 			lda $5F
00:B925 20E9B7          	 13022: 			jsr ntc_sid_off
00:B928 4C6EB9          	 13023: 			jmp ntc_sid_u_n
                        	 13024: ntc_sid_u_sl:
00:B92B 18              	 13025: 			clc							; period += slide, kept 1 .. 1023 (a tone)
00:B92C BD69B7          	 13026: 			lda ntc_sidch+2,x
00:B92F 7D6BB7          	 13027: 			adc ntc_sidch+4,x
00:B932 9D69B7          	 13028: 			sta ntc_sidch+2,x
00:B935 BD6AB7          	 13029: 			lda ntc_sidch+3,x
00:B938 7D6CB7          	 13030: 			adc ntc_sidch+5,x
00:B93B 9D6AB7          	 13031: 			sta ntc_sidch+3,x
00:B93E A55F            	 13032: 			lda $5F
00:B940 C903            	 13033: 			cmp #3
00:B942 F027            	 13034: 			beq ntc_sid_u_out
00:B944 BD6AB7          	 13035: 			lda ntc_sidch+3,x
00:B947 3007            	 13036: 			bmi ntc_sid_u_lo
00:B949 D012            	 13037: 			bne ntc_sid_u_hi
00:B94B BD69B7          	 13038: 			lda ntc_sidch+2,x
00:B94E D01B            	 13039: 			bne ntc_sid_u_out
                        	 13040: ntc_sid_u_lo:
00:B950 A901            	 13041: 			lda #1
00:B952 9D69B7          	 13042: 			sta ntc_sidch+2,x
00:B955 A900            	 13043: 			lda #0
00:B957 9D6AB7          	 13044: 			sta ntc_sidch+3,x
00:B95A 4C6BB9          	 13045: 			jmp ntc_sid_u_out
                        	 13046: ntc_sid_u_hi:
00:B95D C904            	 13047: 			cmp #4
00:B95F 900A            	 13048: 			bcc ntc_sid_u_out
00:B961 A9FF            	 13049: 			lda #<1023
00:B963 9D69B7          	 13050: 			sta ntc_sidch+2,x
00:B966 A903            	 13051: 			lda #>1023
00:B968 9D6AB7          	 13052: 			sta ntc_sidch+3,x
                        	 13053: ntc_sid_u_out:
00:B96B 2005B8          	 13054: 			jsr ntc_sid_out
                        	 13055: ntc_sid_u_n:
00:B96E E65F            	 13056: 			inc $5F
00:B970 A55F            	 13057: 			lda $5F
00:B972 C904            	 13058: 			cmp #4
00:B974 F0034CF3B8      	 13059: 			bne ntc_sid_u_l
00:B979 60              	 13060: 			rts
