00:203A 8D02DC          	    45: 			sta $DC02
00:203D 8D03DC          	    46: 			sta $DC03
00:2040 A200            	    47: 			ldx #0						; keys still in the queue (the RETURN of RUN ...) dropped
                        	    48: ntc_m65_b_kq:
00:2042 AD10D6          	    49: 			lda $D610
00:2045 F006            	    50: 			beq ntc_m65_b_kq1
