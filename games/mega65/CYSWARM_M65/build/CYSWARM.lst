                        	  8708: ;## ntc_data @shared
                        	  8709: ; ------------------------------------------------------------
                        	  8710: ; The core every program has: the registers, the thread / real stack switch
                        	  8711: ; ------------------------------------------------------------
                        	  8712: ntc_ip		equ $02			; the thread position while on the real stack
                        	  8713: ntc_csp		equ $04			; the real stack (set at start)
                        	  8714: z_p0		equ $06			; pointers
                        	  8715: z_p1		equ $08
                        	  8716: z_p2		equ $0A
                        	  8717: z_p3		equ $0C
                        	  8718: z_p4		equ $0E
                        	  8719: z_p5		equ $10
                        	  8720: z_a			equ $12			; 16 bit values
                        	  8721: z_b			equ $14
                        	  8722: z_c			equ $16
                        	  8723: z_d			equ $18
                        	  8724: z_e			equ $1A
                        	  8725: z_f			equ $1C
                        	  8726: z_g			equ $1E
                        	  8727: z_l0		equ $20			; 32 bit values
                        	  8728: z_l1		equ $24
                        	  8729: z_l2		equ $28
                        	  8730: z_l3		equ $2C
                        	  8731: z_t0		equ $30			; bytes
                        	  8732: z_t1		equ $31
                        	  8733: z_t2		equ $32
                        	  8734: z_t3		equ $33
                        	  8735: z_t4		equ $34
                        	  8736: z_t5		equ $35
                        	  8737: z_t6		equ $36
                        	  8738: z_t7		equ $37
                        	  8739: z_q0		equ $40			; 32 bit (far) pointers
                        	  8740: z_q1		equ $44
00:987E 60              	  8741: ntc_next:	rts						; continues the thread
00:987F 0000            	  8742: ntc_ivar:	dw 0					; input / val: dest var
00:9881 00              	  8743: ntc_numbuf:	ds 16					; printint / long print: digits
