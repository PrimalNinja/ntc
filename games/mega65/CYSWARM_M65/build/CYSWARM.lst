00:2016 A947            	    24: 			lda #$47					; the VIC-IV's registers (I/O "knock")
00:2018 8D2FD0          	    25: 			sta $D02F
00:201B A953            	    26: 			lda #$53
00:201D 8D2FD0          	    27: 			sta $D02F
00:2020 A900            	    28: 			lda #0						; no MAP: the CPU sees bank 0 (and $D000 I/O)
00:2022 AA              	    29: 			tax
00:2023 A8              	    30: 			tay
00:2024 4B              	    31: 			taz
00:2025 5C              	    32: 			map
00:2026 EA              	    33: 			eom
00:2027 A900            	    34: 			lda #0
00:2029 5B              	    35: 			tab							; base page 0
00:202A 8D30D0          	    36: 			sta $D030					; no C65 ROM banked in
00:202D A935            	    37: 			lda #$35					; RAM at $A000 and $E000, I/O at $D000
00:202F 8501            	    38: 			sta $01
00:2031 A2EF            	    39: 			ldx #<$07EF					; the real stack, 16 bits
00:2033 9A              	    40: 			txs
00:2034 A007            	    41: 			ldy #>$07EF
00:2036 2B              	    42: 			tys
00:2037 02              	    43: 			cle
