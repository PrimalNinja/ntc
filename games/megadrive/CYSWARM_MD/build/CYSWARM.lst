00:0000A2EE 41F900FF836C    	  7869: 			lea ntc_shadow, a0
00:0000A2F4 7400            	  7870: 			moveq #0, d2				; row
00:0000A2F6 7600            	  7871: 			moveq #0, d3
00:0000A2F8 163900FF835B    	  7872: 			move.b ntc_tattr, d3
00:0000A2FE E14B            	  7873: 			lsl.w #8, d3
                            	  7874: ntc_rd_row:
