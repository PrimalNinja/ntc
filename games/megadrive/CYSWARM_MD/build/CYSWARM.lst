                            	  7897: ;## ntc_plat_cls @unit ntc_plat_screen ntc_plat_data ntc_data
                            	  7898: ; ntc_plat_cls - clear the console, the cursor home
                            	  7899: ntc_plat_cls:
00:0000A336 48E78080        	  7900: 			movem.l d0/a0, -(sp)
00:0000A33A 41F900FF836C    	  7901: 			lea ntc_shadow, a0
00:0000A340 303C045F        	  7902: 			move.w #40*28-1, d0
                            	  7903: ntc_cls_lp:
00:0000A344 10FC0020        	  7904: 			move.b #' ', (a0)+
00:0000A348 51C8FFFA        	  7905: 			dbra d0, ntc_cls_lp
00:0000A34C 423900FF8356    	  7906: 			clr.b ntc_curx
00:0000A352 423900FF8357    	  7907: 			clr.b ntc_cury
00:0000A358 423900FF835A    	  7908: 			clr.b ntc_wrapped
00:0000A35E 618A            	  7909: 			bsr ntc_md_redraw
00:0000A360 4CDF0101        	  7910: 			movem.l (sp)+, d0/a0
00:0000A364 4E75            	  7911: 			rts
