                            	  7434: ;## ntc_md_boot ntc_plat_data ntc_data ntc_md_vdp ntc_md_fontdata ntc_plat_screen
                            	  7435: ; ------------------------------------------------------------
                            	  7436: ; the start ($200): TMSS, the Z80 held, RAM cleared and the RAM block copied
                            	  7437: ; from the ROM, the VDP, the font, the pads, the PSG quiet; then user mode
                            	  7438: ; on the real stack and into ntc_start
                            	  7439: ; ------------------------------------------------------------
                            	  7440: VDP_DATA	equ $C00000
                            	  7441: VDP_CTRL	equ $C00004
                            	  7442: PSG_PORT	equ $C00011
                            	  7443: NTC_USTACK	equ $00FF7800			; the real stack's top
                            	  7444: ntc_md_entry:
00:00009E74 46FC2700        	  7445: 			move.w #$2700, sr
00:00009E78 103900A10001    	  7446: 			move.b $A10001, d0
00:00009E7E 0200000F        	  7447: 			andi.b #$0F, d0
00:00009E82 670A            	  7448: 			beq ntc_mb_notmss
00:00009E84 23FC5345474100A1	  7449: 			move.l #'SEGA', $A14000		; TMSS
00:00009E8C 4000
                            	  7450: ntc_mb_notmss:
00:00009E8E 33FC010000A11100	  7451: 			move.w #$0100, $A11100		; the Z80's bus ours
00:00009E96 33FC000000A11200	  7452: 			move.w #$0000, $A11200		; and the Z80 held in reset
00:00009E9E 41F900FF0000    	  7453: 			lea $FF0000, a0				; RAM cleared (below the supervisor stack's last words: no)
00:00009EA4 303C1FFF        	  7454: 			move.w #($8000/4)-1, d0
                            	  7455: ntc_mb_clr:
00:00009EA8 4298            	  7456: 			clr.l (a0)+
00:00009EAA 51C8FFFC        	  7457: 			dbra d0, ntc_mb_clr
00:00009EAE 41F900FF8000    	  7458: 			lea $FF8000, a0
00:00009EB4 303C1FFF        	  7459: 			move.w #($8000/4)-1, d0
                            	  7460: ntc_mb_clr2:
00:00009EB8 4298            	  7461: 			clr.l (a0)+
00:00009EBA 51C8FFFC        	  7462: 			dbra d0, ntc_mb_clr2
00:00009EBE 41FA091A        	  7463: 			lea ntc_romend, a0			; the RAM block's first image, from the ROM
00:00009EC2 43F900FF8000    	  7464: 			lea ntc_ram, a1
00:00009EC8 203C00000A7C    	  7465: 			move.l #ntc_ramend-ntc_ram, d0
