00:0000A36C 0C400027        	  7921: 			cmpi.w #39, d0
00:0000A370 6302            	  7922: 			bls ntc_lo_x1
00:0000A372 7027            	  7923: 			moveq #39, d0
                            	  7924: ntc_lo_x1:
00:0000A374 5341            	  7925: 			subq.w #1, d1
00:0000A376 6A02            	  7926: 			bpl ntc_lo_y0
00:0000A378 7200            	  7927: 			moveq #0, d1
                            	  7928: ntc_lo_y0:
00:0000A37A 0C41001B        	  7929: 			cmpi.w #27, d1
00:0000A37E 6302            	  7930: 			bls ntc_lo_y1
00:0000A380 721B            	  7931: 			moveq #27, d1
                            	  7932: ntc_lo_y1:
00:0000A382 13C000FF8356    	  7933: 			move.b d0, ntc_curx
00:0000A388 13C100FF8357    	  7934: 			move.b d1, ntc_cury
00:0000A38E 423900FF835A    	  7935: 			clr.b ntc_wrapped
00:0000A394 4E75            	  7936: 			rts
