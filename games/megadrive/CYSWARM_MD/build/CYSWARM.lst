00:0000A302 EF48            	  7876: 			lsl.w #7, d0
00:0000A304 0640C000        	  7877: 			addi.w #$C000, d0
00:0000A308 6100FE86        	  7878: 			bsr ntc_md_vaddr
00:0000A30C 7227            	  7879: 			moveq #40-1, d1
                            	  7880: ntc_rd_col:
