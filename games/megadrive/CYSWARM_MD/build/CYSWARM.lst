00:0000A2C4 41F900FF836C    	  7852: 			lea ntc_shadow, a0
00:0000A2CA 43E80028        	  7853: 			lea 40(a0), a1
00:0000A2CE 303C0437        	  7854: 			move.w #40*27-1, d0
                            	  7855: ntc_sc_mv:
