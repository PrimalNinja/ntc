00:0000A31E 33C000C00000    	  7888: 			move.w d0, VDP_DATA
00:0000A324 51C9FFE8        	  7889: 			dbra d1, ntc_rd_col
00:0000A328 5242            	  7890: 			addq.w #1, d2
00:0000A32A 0C42001C        	  7891: 			cmpi.w #28, d2
00:0000A32E 65D0            	  7892: 			bcs ntc_rd_row
00:0000A330 4CDF010F        	  7893: 			movem.l (sp)+, d0-d3/a0
00:0000A334 4E75            	  7894: 			rts
