                            	  7938: 			even
                            	  7939: ;## ntc_md_logs
                            	  7940: 		ifd NTC_MDLOG
                            	  7941: ; test builds (vasm -DNTC_MDLOG): what the console was given, at $FF0000 on (the
                            	  7942: ; harness reads it): characters, 10 for a new line. $FF6FFC: where the next goes
                            	  7943: ntc_md_log:
                            	  7944: 			move.l a0, -(sp)
                            	  7945: 			movea.l $FF6FFC, a0
                            	  7946: 			cmpa.l #$FF0000, a0
                            	  7947: 			bcc ntc_lg_ok
                            	  7948: 			lea $FF0000, a0
                            	  7949: ntc_lg_ok:
                            	  7950: 			cmpa.l #$FF6FF0, a0
                            	  7951: 			bcc ntc_lg_full
                            	  7952: 			move.b d0, (a0)+
                            	  7953: 			move.l a0, $FF6FFC
                            	  7954: ntc_lg_full:
                            	  7955: 			movea.l (sp)+, a0
                            	  7956: 			rts
                            	  7957: 		endif
                            	  7958: 
                            	  7959: 			even
                            	  7960: ;## ntc_plat_frame ntc_plat_data
                            	  7961: ; ntc_plat_frame - wait for the next frame interrupt (the start of the vertical blank)
                            	  7962: ntc_plat_frame:
00:0000A396 2F00            	  7963: 			move.l d0, -(sp)
00:0000A398 303900FF8360    	  7964: 			move.w ntc_vbl, d0
                            	  7965: ntc_fr_lp:
00:0000A39E B07900FF8360    	  7966: 			cmp.w ntc_vbl, d0
00:0000A3A4 67F8            	  7967: 			beq ntc_fr_lp
00:0000A3A6 201F            	  7968: 			move.l (sp)+, d0
00:0000A3A8 4E75            	  7969: 			rts
                            	  7970: 
                            	  7971: 			even
                            	  7972: ;## ntc_plat_ticks ntc_plat_data
                            	  7973: ; ntc_plat_ticks - d0.w = frames since the start (60 a second, 50 on a PAL machine)
                            	  7974: ntc_plat_ticks:
00:0000A3AA 303900FF835E    	  7975: 			move.w ntc_ticks, d0
00:0000A3B0 4E75            	  7976: 			rts
                            	  7977: 
                            	  7978: 			even
                            	  7979: ;## ntc_plat_exit ntc_plat_data
                            	  7980: ; ntc_plat_exit - before the program stops: nothing to give back on a Mega Drive
                            	  7981: ntc_plat_exit:
00:0000A3B2 4E75            	  7982: 			rts
                            	  7983: 
                            	  7984: 			even
                            	  7985: ;## ntc_md_spr ntc_md_vdp ntc_data
                            	  7986: ; ------------------------------------------------------------
                            	  7987: ; the hardware sprites: a copy of the VDP's sprite table in RAM (80 x 8 bytes:
                            	  7988: ; y + 128 (0 = hidden), size, the cell value, x + 128); ntc_md_sprupd writes it
                            	  7989: ; to the VDP ($D800) with the links 0 -> 1 -> ... -> 79. On the thread: keywords.
                            	  7990: ; ------------------------------------------------------------
                            	  7991: ; ntc_md_sprupd - the sprite table to the VDP (call it after Frame). Real stack
                            	  7992: ntc_md_sprupd:
00:0000A3B4 48E7E080        	  7993: 			movem.l d0-d2/a0, -(sp)
00:0000A3B8 303CD800        	  7994: 			move.w #$D800, d0
00:0000A3BC 6100FDD2        	  7995: 			bsr ntc_md_vaddr
00:0000A3C0 41F900FF87CC    	  7996: 			lea ntc_sat, a0
00:0000A3C6 7201            	  7997: 			moveq #1, d1				; the link
                            	  7998: ntc_su_lp:
00:0000A3C8 33D800C00000    	  7999: 			move.w (a0)+, VDP_DATA		; y
00:0000A3CE 3418            	  8000: 			move.w (a0)+, d2			; size
00:0000A3D0 E14A            	  8001: 			lsl.w #8, d2
00:0000A3D2 0C410050        	  8002: 			cmpi.w #80, d1
00:0000A3D6 6402            	  8003: 			bcc ntc_su_last
00:0000A3D8 1401            	  8004: 			move.b d1, d2
                            	  8005: ntc_su_last:
00:0000A3DA 33C200C00000    	  8006: 			move.w d2, VDP_DATA			; size, link (the last links to 0)
00:0000A3E0 23D800C00000    	  8007: 			move.l (a0)+, VDP_DATA		; the cell value, x
00:0000A3E6 5241            	  8008: 			addq.w #1, d1
00:0000A3E8 0C410051        	  8009: 			cmpi.w #81, d1
00:0000A3EC 65DA            	  8010: 			bcs ntc_su_lp
00:0000A3EE 4CDF0107        	  8011: 			movem.l (sp)+, d0-d2/a0
00:0000A3F2 4E75            	  8012: 			rts
                            	  8013: 
                            	  8014: 			even
                            	  8015: ;## ntc_md_psg ntc_data
                            	  8016: ; ------------------------------------------------------------
                            	  8017: ; the PSG's 4 channels (3 tones, the noise) as sound effects that move on a frame
                            	  8018: ; at a time (ntc_md_psgupd, from Psg.Update): a period that slides and a volume
                            	  8019: ; that fades. A channel: active, period, slide, volume, frames, left (12 bytes)
                            	  8020: ; ------------------------------------------------------------
                            	  8021: ; ntc_md_psgout - a0 = the channel's state, d3 = its number: its period and volume to the PSG
                            	  8022: ntc_md_psgout:
00:0000A3F4 30280002        	  8023: 			move.w 2(a0), d0			; the period
00:0000A3F8 0C430003        	  8024: 			cmpi.w #3, d3
00:0000A3FC 6724            	  8025: 			beq ntc_po_noise
00:0000A3FE 3203            	  8026: 			move.w d3, d1
00:0000A400 EB09            	  8027: 			lsl.b #5, d1
00:0000A402 00010080        	  8028: 			ori.b #$80, d1
00:0000A406 3400            	  8029: 			move.w d0, d2
00:0000A408 0202000F        	  8030: 			andi.b #$0F, d2
00:0000A40C 8202            	  8031: 			or.b d2, d1
00:0000A40E 13C100C00011    	  8032: 			move.b d1, PSG_PORT
00:0000A414 E848            	  8033: 			lsr.w #4, d0
00:0000A416 0200003F        	  8034: 			andi.b #$3F, d0
00:0000A41A 13C000C00011    	  8035: 			move.b d0, PSG_PORT
00:0000A420 600E            	  8036: 			bra ntc_po_vol
                            	  8037: ntc_po_noise:
00:0000A422 02000007        	  8038: 			andi.b #7, d0
00:0000A426 000000E0        	  8039: 			ori.b #$E0, d0
00:0000A42A 13C000C00011    	  8040: 			move.b d0, PSG_PORT
                            	  8041: ntc_po_vol:
                            	  8042: 			; the volume now: volume * left / frames (frames 0: the volume)
00:0000A430 30280006        	  8043: 			move.w 6(a0), d0
00:0000A434 32280008        	  8044: 			move.w 8(a0), d1
00:0000A438 6706            	  8045: 			beq ntc_po_v
00:0000A43A C0E8000A        	  8046: 			mulu.w 10(a0), d0
00:0000A43E 80C1            	  8047: 			divu.w d1, d0
                            	  8048: ntc_po_v:
00:0000A440 720F            	  8049: 			moveq #15, d1
00:0000A442 9240            	  8050: 			sub.w d0, d1				; the attenuation
00:0000A444 6402            	  8051: 			bcc ntc_po_v2
00:0000A446 7200            	  8052: 			moveq #0, d1
                            	  8053: ntc_po_v2:
00:0000A448 3003            	  8054: 			move.w d3, d0
00:0000A44A EB08            	  8055: 			lsl.b #5, d0
00:0000A44C 00000090        	  8056: 			ori.b #$90, d0
00:0000A450 0201000F        	  8057: 			andi.b #$0F, d1
00:0000A454 8001            	  8058: 			or.b d1, d0
00:0000A456 13C000C00011    	  8059: 			move.b d0, PSG_PORT
00:0000A45C 4E75            	  8060: 			rts
                            	  8061: 
                            	  8062: ; ntc_md_psgoff - d3 = the channel: silent, not active
                            	  8063: ntc_md_psgoff:
