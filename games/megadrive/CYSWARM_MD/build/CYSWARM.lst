                            	  7914: ;## ntc_plat_locate @unit ntc_plat_screen ntc_plat_data ntc_data
                            	  7915: ; ntc_plat_locate - d0 = column, d1 = row (1 based, kept on the screen)
                            	  7916: ntc_plat_locate:
00:0000A366 5340            	  7917: 			subq.w #1, d0
00:0000A368 6A02            	  7918: 			bpl ntc_lo_x0
00:0000A36A 7000            	  7919: 			moveq #0, d0
