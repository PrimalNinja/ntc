                            	  7779: 			bsr ntc_md_log
                            	  7780: 		endif
00:0000A1F6 7200            	  7781: 			moveq #0, d1
00:0000A1F8 123900FF8357    	  7782: 			move.b ntc_cury, d1
00:0000A1FE C2FC0028        	  7783: 			mulu.w #40, d1
00:0000A202 7400            	  7784: 			moveq #0, d2
00:0000A204 143900FF8356    	  7785: 			move.b ntc_curx, d2
00:0000A20A D242            	  7786: 			add.w d2, d1
00:0000A20C 41F900FF836C    	  7787: 			lea ntc_shadow, a0
00:0000A212 11801000        	  7788: 			move.b d0, 0(a0, d1.w)
00:0000A216 612E            	  7789: 			bsr ntc_md_cell			; d0 = char, the cursor's cell
00:0000A218 523900FF8356    	  7790: 			addq.b #1, ntc_curx
00:0000A21E 103900FF8356    	  7791: 			move.b ntc_curx, d0
00:0000A224 B03900FF8358    	  7792: 			cmp.b ntc_scols, d0
00:0000A22A 650E            	  7793: 			bcs ntc_pc_nowrap
00:0000A22C 13FC000100FF835A	  7794: 			move.b #1, ntc_wrapped
00:0000A234 4CDF0107        	  7795: 			movem.l (sp)+, d0-d2/a0
00:0000A238 6062            	  7796: 			bra ntc_nl_do
                            	  7797: ntc_pc_nowrap:
