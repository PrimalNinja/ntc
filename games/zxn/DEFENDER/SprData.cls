' SprData - DEFENDER: the 16 sprite patterns and their palette, made by tools/sprdata.js (change the
' pictures there, not here). Upload sets the sprite palette and sends the patterns to the Next:
' 0 ship, 1 lander, 2 mutant, 3 human, 4-7 their second frames, 8 the laser bolt, 9 an enemy
' shot, 10-13 the explosion, 14-15 the baiter.
' (c) 2026 Cyborg Unicorn Pty Ltd - MIT License
Option Explicit

Public Sub Upload()
#asm
            ld bc, #243B            ; the sprites' first palette, from colour 0
            ld a, #43
            out (c), a
            inc b
            ld a, #20
            out (c), a
            dec b
            ld a, #40
            out (c), a
            inc b
            xor a
            out (c), a
            dec b
            ld a, #44
            out (c), a
            inc b
            ld hl, sd_pal
            ld e, 32
sd_pl:
            ld a, (hl)
            out (c), a
            inc hl
            dec e
            jr nz, sd_pl
            ld bc, #303B            ; pattern 0 on
            xor a
            out (c), a
            ld hl, sd_pat
            ld de, 16 * 256         ; 16 patterns of 256 bytes
sd_pt:
            ld a, (hl)
            out (#5B), a
            inc hl
            dec de
            ld a, d
            or e
            jr nz, sd_pt
            jp sd_end
sd_pal:
