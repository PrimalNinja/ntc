Public Const S_MON = 0
Public Const S_MON_N = 8
Public Const S_MON_W = 2
Public Const S_MON_H = 2
Public Const S_MON2 = 32
Public Const S_MON2_N = 4
Public Const S_MON2_W = 2
Public Const S_MON2_H = 2
