' GfxData - the game's graphics, made by gfxtool.js from gfx/*.png and layout.txt.
' Don't edit: change the PNGs and run  node gfxtool.js build
' Load: the tilemap palette, the sprite palettes, the tile definitions (bank 5 + #0000, seen at
' #C000: Tiles.Init points the tilemap there) and the sprite patterns (4 bit, from pattern 0).
Option Explicit

Public Const S_HELI = 0
Public Const S_HELI_N = 2
Public Const S_HELI_W = 2
Public Const S_SHOT = 4
Public Const S_SHOT_N = 1
Public Const S_LANDER = 5
Public Const S_LANDER_N = 2
Public Const S_MUTANT = 7
Public Const S_MUTANT_N = 2
Public Const S_BOMBER = 9
Public Const S_BOMBER_N = 2
Public Const S_POD = 11
Public Const S_POD_N = 2
Public Const S_SWARMER = 13
Public Const S_SWARMER_N = 2
Public Const S_BAITER = 15
Public Const S_BAITER_N = 2
Public Const S_PERSON = 17
Public Const S_PERSON_N = 3
Public Const S_BEAM = 20
Public Const S_BEAM_N = 1
Public Const S_MINE = 21
Public Const S_MINE_N = 1
Public Const S_BULLET = 22
Public Const S_BULLET_N = 2
Public Const S_BOOM = 24
Public Const S_BOOM_N = 4
Public Const S_WINDOW = 28
Public Const S_WINDOW_N = 1
Public Const S_STARS = 29
Public Const S_STARS_N = 1
Public Const T_HUD = 1
Public Const T_SCAN = 2
Public Const T_SCANT = 3
Public Const T_SCANG = 4
Public Const T_LIFE = 5
Public Const T_SMART = 6
Public Const T_BLACK = 7
Public Const T_DOT = 96
Public Const T_DOT_N = 36
Public Const SpritePatterns = 30
Public Const SpritePalettes = 5

Private sps As Integer

Public Sub Load()
#asm
            ld ({sps}), sp          ; the real stack (calls)
            ld sp, (ntc_csp)
            ld bc, #243B
            ld a, #43               ; palette control: the tilemap's first palette
            out (c), a
            inc b
            ld a, #30
            out (c), a
            dec b
            ld hl, tpal
            ld e, 16
            call palset
            ld a, #43               ; the sprites' first palette
            out (c), a
            inc b
            ld a, #20
            out (c), a
            dec b
            ld hl, spal
            ld e, 80                ; 5 x 16 (0 = 256)
            call palset
            ld a, #43               ; back to the ULA's, first palettes in use
            out (c), a
            inc b
            xor a
            out (c), a
            ld hl, #C000            ; every tile transparent (colour 15) first
            ld de, #C001
            ld bc, #1FFF
            ld (hl), #FF
            ldir
            ld hl, truns
ld_run:
            ld a, (hl)              ; a run: first tile, count (0, 0 = the end), its definitions
            inc hl
            ld c, (hl)
            inc hl
            ld b, a
            or c
            jr z, ld_spr
            ld a, b
            ld e, a                 ; DE = #C000 + first * 32
            ld d, 0
            ex de, hl
            add hl, hl
            add hl, hl
            add hl, hl
            add hl, hl
            add hl, hl
            ld a, h
            add a, #C0
            ld h, a
            ex de, hl
            ld a, c                 ; BC = count * 32 (count 1 - 255: tile 0 run of 0 not used)
            ld b, 0
            ld c, a
            push hl
            ld h, b
            ld l, c
            add hl, hl
            add hl, hl
            add hl, hl
            add hl, hl
            add hl, hl
            ld b, h
            ld c, l
            pop hl
            ldir
            jr ld_run
ld_spr:
            ld bc, #303B            ; sprite patterns from pattern 0
            xor a
            out (c), a
            ld hl, pats
            ld de, 3840
            ld c, #5B
ld_pat:
            ld a, d
            or e
            jr z, ld_done
            ld a, (hl)
            out (c), a
            inc hl
            dec de
            jr ld_pat
ld_done:
            ld sp, ({sps})
            jp ld_end
; palset - E colours (0 = 256) from HL into the palette chosen, from index 0 (BC = #243B)
palset:
            ld a, #40
            out (c), a
            inc b
            xor a
            out (c), a
            dec b
ps_lp:
            ld a, #41
            out (c), a
            inc b
            ld a, (hl)
            out (c), a
            dec b
            inc hl
            dec e
            jr nz, ps_lp
            ret
