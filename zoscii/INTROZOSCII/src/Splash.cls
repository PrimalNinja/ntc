' the palette at brightness k (0 black - 16 full)
Private Sub Level(ByVal k As Integer)
#asm
            pop hl
            ld l, (hl)              ; spl_lev + k * 64
            ld h, 0
            add hl, hl
            add hl, hl
            add hl, hl
            add hl, hl
            add hl, hl
            add hl, hl
            ld de, spl_lev
            add hl, de
            xor a
            SPW #43
            xor a
            SPW #40
            ld e, 64
spl_l:
            ld a, (hl)
            inc hl
            SPW #44
            dec e
            jr nz, spl_l
#endasm
End Sub

' everything put back as it was (the border black)
Private Sub Finish()
#asm
            xor a
            SPW #43
            xor a
            SPW #40
            ld hl, spl_pal
            ld e, 64
spf_l:
            ld a, (hl)
            inc hl
            SPW #44
            dec e
            jr nz, spf_l
            ld a, (spl_r43)
            SPW #43
            ld a, (spl_r68)
            SPW #68
            ld a, (spl_r15)
            SPW #15
            ld a, (spl_r69)
            SPW #69
            ld a, (spl_r6b)
            SPW #6B
            ld a, (spl_r56)
            SPW #56
            xor a                   ; the border black
            out (#FE), a
#endasm
End Sub

' 1 while any key is down
Private Function Key() As Integer
#asm
            xor a                   ; every half row at once
            in a, (#FE)
            cpl
            and #1F
            ld e, 0
            jr z, spk_n
            inc e
spk_n:
            pop hl
            ld (hl), e
            inc hl
            ld (hl), 0
#endasm
End Function

' the splash: n 1 the unicorn, 0 plain, 2 NTC BASIC
Public Sub Show(ByVal n As Integer)
  Dim a As Integer
  a = 0
#If SplashNoLogo = 0 Then
  If n = 1 Then a = LogoAt()
#End If
#If SplashNoPlain = 0 Then
  If n = 0 Then a = PlainAt()
#End If
#If SplashNoNtc = 0 Then
  If n = 2 Then a = NtcAt()
#End If
  If a <> 0 Then Run a
End Sub

' the screen packed at src: in (1 second: 16 steps, 3 frames each), 3 seconds, out (1 second); a key:
' out quickly
Private Sub Run(ByVal src As Integer)
  Dim k As Integer, t As Integer, held As Integer, skip As Integer, hold As Integer
  Begin src
  held = Key()
  skip = 0
  k = 0
  Do While k < 16 And skip = 0
    k = k + 1
    Level k
    For t = 1 To 3
      Frame
    Next
    If Key() = 0 Then
      held = 0
    ElseIf held = 0 Then
      skip = 1
    End If
  Loop
  hold = 0
  Do While hold < 150 And skip = 0
    Frame
    hold = hold + 1
    If Key() = 0 Then
      held = 0
    ElseIf held = 0 Then
      skip = 1
    End If
  Loop
  Do While k > 0
    k = k - 1
    Level k
    Frame
    If skip = 0 Then
      Frame
      Frame
    End If
  Loop
  Finish
End Sub
