@@ -245,6 +245,7 @@ TownsCommandInterpreter::TownsCommandInterpreter()
 
 
 	primaryCmdMap["GAMEPORT"]=CMD_GAMEPORT;
+	primaryCmdMap["PADSET"]=CMD_PADSET;
 	primaryCmdMap["TOGGLE_HOST_MOUSE_CURSOR"]=CMD_TOGGLE_HOST_MOUSE_CURSOR;
 	primaryCmdMap["TOGGLEMOUSE"]=CMD_TOGGLE_HOST_MOUSE_CURSOR;
 
@@ -1974,6 +1975,23 @@ void TownsCommandInterpreter::Execute(TownsThread &thr,FMTownsCommon &towns,clas
 	case CMD_GAMEPORT:
 		Execute_Gameport(towns,outside_world,cmd);
 		break;
+	case CMD_PADSET:
+		if(3<=cmd.argv.size())
+		{
+			unsigned int port=cpputil::Atoi(cmd.argv[1].c_str())&1;
+			unsigned int b=cpputil::Atoi(cmd.argv[2].c_str());
+			auto &p=towns.gameport.state.ports[port];
+			p.device=TownsGamePort::GAMEPAD;
+			p.up=(0!=(b&1));
+			p.down=(0!=(b&2));
+			p.left=(0!=(b&4));
+			p.right=(0!=(b&8));
+			p.button[0]=(0!=(b&16));
+			p.button[1]=(0!=(b&32));
+			p.run=(0!=(b&64));
+			p.pause=(0!=(b&128));
+		}
+		break;
 	case CMD_TOGGLE_HOST_MOUSE_CURSOR:
 		outside_world->ToggleMouseCursor();
 		break;
