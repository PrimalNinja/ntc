' Net (lib/z80/Net.cls) test: the small model test/net_t.mdl (tools/gen/mktest.py) loaded, the
' prompt fed, 48 characters generated by the biggest logit - must be what the PC's integer
' reference gave (test/net_t.txt), byte for byte. Prints "NET " and the 48 characters (newlines
' as "|"), then "NET ok" when the model loaded and every character came.
Option Explicit
Dim mdl(11999) As Byte
Dim n As Integer, i As Integer, c As Integer, s As String Max 60, p As String Max 40, ch As String Max 1
n = FileSystem.Load("NETT.MDL", VarPtr(mdl(0)), 12000)
If n <= 0 Then Print "NET no model" : End
If Net.Load(VarPtr(mdl(0)), n) = 0 Then Print "NET bad header" : End
Print "NET v"; Net.Vocab(); " h"; Net.Hidden(); " l"; Net.Layers()
p = "Dim i As Integer" + Chr$(10) + "For i = 1 To 10" + Chr$(10)
Net.Reset
For i = 1 To Len(p)
  c = Net.Feed(Net.Index(Mid$(p, i, 1)))
Next
s = ""
For i = 1 To 48
  ch = Net.Char(c)
  If ch = Chr$(10) Then ch = "|"
  s = s + ch
  c = Net.Feed(c)
Next
Print "NET "; s
Print "NET ok"
