10 ' Locomotive files and keys: OPENOUT / PRINT #9 / CLOSEOUT, OPENIN / LINE INPUT #9 / EOF, INKEY(n), JOY(n)
20 OPENOUT "SCORES.TXT"
30 FOR i=1 TO 3:PRINT #9,"Player";i;i*100:NEXT
40 PRINT #9,"end"
50 CLOSEOUT
60 OPENIN "SCORES.TXT"
70 WHILE NOT EOF
80 LINE INPUT #9,a$:PRINT "[";a$;"]"
90 WEND
100 CLOSEIN
110 OPENIN "SCORES.TXT":INPUT #9,b$:CLOSEIN:PRINT "first ";b$
120 PRINT "space";INKEY(47);" joy";JOY(0)
130 k=0
140 IF INKEY(47)=0 THEN PRINT "held":k=k+1:WHILE INKEY(47)=0:WEND
150 IF JOY(0)>0 THEN PRINT "joy";JOY(0):k=k+1:WHILE JOY(0)>0:WEND
160 IF k<2 THEN 140
170 PRINT "done"
