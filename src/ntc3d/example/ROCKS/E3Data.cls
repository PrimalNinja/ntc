' DatAt(): where the data block's tables are, at #C000 on (its bank in slots 6 and 7): the
' projection's reciprocals (2^24 / n, n 256-4095), the palette, the stars, the model table (near
' and far models' offsets), the hit table (across, up), the models
Public Function DatAt() As Integer
#asm
            pop hl
            ld (hl), 0
            inc hl
            ld (hl), #C0
            jp dat_e
@d_rproj:     equ #C000
@d_pal:     equ #DE00
@d_stars:     equ #E000
@d_modeltab:     equ #E100
@d_hittab:     equ #E120
@d_modeldata:     equ #E130
@d_texts:     equ 0
dat_e:
#endasm
End Function

