;
; Fonctions de gestion FTP
;

;
; Routines FTP haut niveau
;

;
; Démarre une connexion FTP en binaire en mode passif
;
; Entrée - Aucune
; Sortie - Si Carry = 1 alors la connexion a pu se faire
;               C = Socket de commande créée
;          Si Carry = 0 alors la connexion a échoué
;               Si Z alors la socket a échoué
;               Si NZ alors l'identification FTP a échoué
; Altéré - AF,BC,_DOS_ROM_TEMP_ROUTINE,_DOS_ROM_TEMP_STORE

M4_FTPConnect
        push de
        push hl
        push ix
        push iy

        call M4_FTPConnectInternal

        pop iy
        pop ix
        pop hl
        pop de
        ret

M4_FTPConnectInternal
        call M4_CreateSocket
        jp nc,M4FTPSocketFailure

        ld hl,_DOS_ROM_TEMP_STORE
        call M4_GetFTP
        jp nc,M4FTPSocketError

        ; Connexion

        ld a,(_DOS_ROM_TEMP_STORE+5):ld ixh,a ; Port
        ld a,(_DOS_ROM_TEMP_STORE+4):ld ixl,a

        ld a,(_DOS_ROM_TEMP_STORE+3):ld d,a ; IP
        ld a,(_DOS_ROM_TEMP_STORE+2):ld e,a
        ld a,(_DOS_ROM_TEMP_STORE+1):ld h,a
        ld a,(_DOS_ROM_TEMP_STORE+0):ld l,a

        call M4_ConnectSocket
        jp nc,M4FTPSocketError

        call M4_FTPGetResponse
        jp nc,M4FTPTransferError

        ld hl,220
        call cp_iy_hl
        jp nz,M4FTPTransferError

        ; User

        push bc
        MAKE_ID_DEHL 'U','S','E','R'
        call M4_FTPStartCommand

        ld hl,_DOS_ROM_TEMP_STORE
        call M4_GetFTP
        ld hl,_DOS_ROM_TEMP_STORE+6 ; Serveur...
        ld e,(hl)
        ld d,0
        inc hl
        add hl,de                   ; Identifiant !
        ld b,(hl)
        inc hl

        call M4_FTPPushArgCommand
        call M4_FTPFinalizeCommand
        pop bc

        call M4_FTPSendCommand
        jp nc,M4FTPSocketError
        call M4_FTPGetResponse
        jp nc,M4FTPSocketError

        ld hl,331
        call cp_iy_hl
        jp nz,M4FTPTransferError

        ; Pass

        push bc
        MAKE_ID_DEHL 'P','A','S','S'
        call M4_FTPStartCommand

        ld hl,_DOS_ROM_TEMP_STORE
        call M4_GetFTP
        ld hl,_DOS_ROM_TEMP_STORE+6 ; Serveur...
        ld e,(hl)
        ld d,0
        inc hl
        add hl,de                   ; Identifiant...
        ld e,(hl)
        inc hl
        add hl,de                   ; Mot de passe !
        ld b,(hl)
        inc hl

        call M4_FTPPushArgCommand
        call M4_FTPFinalizeCommand
        pop bc

        call M4_FTPSendCommand
        jr nc,M4FTPSocketError
        call M4_FTPGetResponse
        jr nc,M4FTPSocketError

        ld hl,230
        call cp_iy_hl
        jr nz,M4FTPTransferError

        ; Binary

        push bc
        MAKE_ID_DEHL 'T','Y','P','E'
        call M4_FTPStartCommand

        ld hl,_DOS_ROM_TEMP_STORE
        ld (hl),'I'
        ld b,1
        call M4_FTPPushArgCommand
        call M4_FTPFinalizeCommand
        pop bc

        call M4_FTPSendCommand
        jr nc,M4FTPSocketError
        call M4_FTPGetResponse
        jr nc,M4FTPSocketError

        ld hl,200
        call cp_iy_hl
        jr nz,M4FTPTransferError

        scf
        ret

M4FTPSocketError
        call M4_FTPDisconnect
M4FTPSocketFailure
        cp a
        ret ; NC,Z
M4FTPTransferError
        call M4_FTPDisconnect
        ld a,-1
        or a
        ret ; NC,NZ

;
; Clôture une connexion FTP
;
; Entrée - C = numéro de socket
; Sortie - Aucune
; Altéré - AF,_DOS_ROM_TEMP_ROUTINE,_DOS_ROM_TEMP_STORE

M4_FTPDisconnect
        push bc
        push de
        push hl
        MAKE_ID_DEHL 'Q','U','I','T'
        call M4_FTPStartCommand
        call M4_FTPFinalizeCommand
        pop hl
        pop de
        pop bc

        call M4_FTPSendCommand
;        jr nc,M4FTPDisconnectExit

;        push bc
;        push de
;        push hl
;        push ix
;        push iy
;        call M4_FTPGetResponse
;        pop iy
;        pop ix
;        pop hl
;        pop de
;        pop bc
M4FTPDisconnectExit
        jp M4_DestroySocket

;
; Change le répertoire en cours
;
; Entrée - C = numéro de socket
;          DE = pointeur vers le chemin normalisé
; Sortie - Si Carry = 1 alors le chemin a pu être sélectionné
;          Si Carry = 0 alors le chemin n'a pas pu être sélectionné
; Altéré - AF,_DOS_ROM_TEMP_ROUTINE,_DOS_ROM_TEMP_STORE

M4_FTPCurrentDir
        push bc
        push de
        push hl
        push ix
        push iy

        call M4_FTPCurrentDirInternal

        pop iy
        pop ix
        pop hl
        pop de
        pop bc
        ret

M4_FTPCurrentDirInternal
        push de
        call M4FTPRootDir
        pop de
        ret nc

        ld a,(de)
        or a
        scf
        ret z

        inc de
        ex de,hl
M4FTPCurrentDirLoop
        ld (_DOS_ROM_TEMP_STORE+&10),a

        push hl
        call M4FTPUnnormalize
        call M4FTPCurrentDirSub
        pop hl

        ret nc

        ld a,(_DOS_ROM_TEMP_STORE+&10)
        dec a
        scf
        ret z

        ld de,11
        add hl,de

        jr M4FTPCurrentDirLoop

; C = numéro de socket, B = longueur (_DOS_ROM_TEMP_STORE)
M4FTPCurrentDirSub
        push bc

        MAKE_ID_DEHL 'C','W','D',' '
        call M4_FTPStartCommand

        ld hl,_DOS_ROM_TEMP_STORE
        call M4_FTPPushArgCommand
        call M4_FTPFinalizeCommand

        pop bc

        call M4_FTPSendCommand
        jr nc,M4FTPCurrentDirSubFailed

        call M4_FTPGetResponse

        ld hl,250
        call cp_iy_hl
        jr nz,M4FTPCurrentDirSubFailed

        scf
        ret

M4FTPCurrentDirSubFailed
        cp a ; NC
        ret

M4FTPUnnormalize
        push bc

        ld de,_DOS_ROM_TEMP_STORE
        call CompactName

        cp a ; NC
        ld hl,_DOS_ROM_TEMP_STORE
        ex de,hl
        sbc hl,de
        ld a,l

        pop bc
        ld b,a

        ret

M4FTPRootDir
        ld a,'/'
        ld (_DOS_ROM_TEMP_STORE),a
        ld b,1
        jr M4FTPCurrentDirSub

;
; Sélectionne le répertoire racine
;
; Entrée - C = numéro de socket
; Sortie - Si Carry = 1 alors le chemin a pu être sélectionné
;          Si Carry = 0 alors le chemin n'a pas pu être sélectionné
;               A = code d'erreur
; Altéré - AF,_DOS_ROM_TEMP_ROUTINE,_DOS_ROM_TEMP_STORE

M4_FTPRootDir
        push bc
        push de
        push hl
        push ix
        push iy
        call M4FTPRootDir
        pop iy
        pop ix
        pop hl
        pop de
        pop bc

        ret c

        ld a,DSK_ERR_BAD_COMMAND
        ret

;
; Renomme "depuis"
;
; Entrée - C = numéro de socket
;          HL = pointeur vers le nom normalisé
;          DE = pointeur vers le chemin normalisé
; Sortie - Si Carry = 1 alors le chemin a pu être sélectionné
;          Si Carry = 0 alors le chemin n'a pas pu être sélectionné
;               A = code d'erreur
; Altéré - AF,_DOS_ROM_TEMP_ROUTINE,_DOS_ROM_TEMP_STORE

M4_FTPRenameFrom
        push bc
        push de
        push hl
        push ix
        push iy

        call M4_FTPRenameFromInternal

        pop iy
        pop ix
        pop hl
        pop de
        pop bc
        ret

M4_FTPRenameFromInternal
        push bc
        push de
        push hl

        MAKE_ID_DEHL 'R','N','F','R'
        call M4_FTPStartCommand
        ld ixl,c

        pop hl
        pop de
        pop bc

        push bc
        push de
        push hl

        call M4FTPAddPath

        pop hl
        pop de
        pop bc

        call M4_FTPSendCommand
        ld a,DSK_ERR_BAD_COMMAND
        ret nc

        call M4_FTPGetResponse
        ld a,DSK_ERR_BAD_COMMAND
        ret nc

        ld hl,350
        call cp_iy_hl

        scf
        ret z

        ld hl,550
        call cp_iy_hl
        scf:ccf
        ld a,DSK_ERR_FILE_NOT_FOUND
        ret z

        ld a,DSK_ERR_BAD_COMMAND
        cp a ; NC
        ret

;
; Renomme "vers"
;
; Entrée - C = numéro de socket
;          HL = pointeur vers le nom normalisé
;          DE = pointeur vers le chemin normalisé
; Sortie - Si Carry = 1 alors le chemin a pu être sélectionné
;          Si Carry = 0 alors le chemin n'a pas pu être sélectionné
;               A = code d'erreur
; Altéré - AF,_DOS_ROM_TEMP_ROUTINE,_DOS_ROM_TEMP_STORE

M4_FTPRenameTo
        push bc
        push de
        push hl
        push ix
        push iy

        call M4_FTPRenameToInternal

        pop iy
        pop ix
        pop hl
        pop de
        pop bc
        ret

M4_FTPRenameToInternal
        push bc
        push de
        push hl

        MAKE_ID_DEHL 'R','N','T','O'
        call M4_FTPStartCommand
        ld ixl,c

        pop hl
        pop de
        pop bc

        push bc
        push de
        push hl

        call M4FTPAddPath

        pop hl
        pop de
        pop bc

        call M4_FTPSendCommand
        ld a,DSK_ERR_BAD_COMMAND
        ret nc

        call M4_FTPGetResponse
        ld a,DSK_ERR_BAD_COMMAND
        ret nc

        ld hl,250
        call cp_iy_hl

        scf
        ret z

        ld hl,553
        call cp_iy_hl
        scf:ccf
        ld a,DSK_ERR_FILE_ALREADY_EXISTS
        ret z

        ld a,DSK_ERR_BAD_COMMAND
        cp a ; NC
        ret

